---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import CountrySwitcher from "../components/CountrySwitcher.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import ExchangeBrands from "../components/ExchangeBrands.astro";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getIndex } from "../lib/markets";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/gate.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
// Search titles: the page's own words first; the brand is added only when the whole title still fits in about
// 60 characters (Google cuts longer titles and shows the site name separately anyway).
const brandRx = new RegExp(`\\s*[|—–-]\\s*${siteTitle.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}$`);
const coreTitle = title === siteTitle ? siteTitle : title.replace(brandRx, "").trim();
const fullTitle = coreTitle === siteTitle || coreTitle.startsWith(`${siteTitle}:`) ? coreTitle
	: coreTitle.length + siteTitle.length + 3 <= 62 ? `${coreTitle} | ${siteTitle}` : coreTitle;
// Descriptions: 158 characters at most (longer ones are cut off in results), ended at a sentence or a word.
function clipDescription(d: string | null | undefined) {
	if (!d) return d;
	const t = d.replace(/\s+/g, " ").trim();
	if (t.length <= 158) return t;
	const cut = t.slice(0, 158);
	const sentence = cut.lastIndexOf(". ");
	return sentence >= 100 ? cut.slice(0, sentence + 1) : cut.slice(0, cut.lastIndexOf(" ")).replace(/[,;:—-]$/, "") + "…";
}
const metaDescription = clipDescription(description);

const menu = menuResult.data;
// Header navigation is built here (not from the CMS menu): a "USA Elections" menu listing every cycle the
// exchanges have listed, from the live market index (so after an election it moves on by itself), then Politics.
const marketIndex = await getIndex().catch(() => null);
const electionLinks = (marketIndex?.cycles ?? [])
	.filter((c) => c.races > 0 || c.offices.includes("president"))
	.flatMap((c) => {
		const kind = c.year % 4 === 2 ? "Midterms" : c.year % 4 === 0 ? "Elections" : "Elections";
		const out: { href: string; label: string; note: string }[] = [];
		if (c.races > 0) out.push({ href: `/${c.year}/`, label: `${c.year} ${kind}`, note: `${c.races} ${c.races === 1 ? "race" : "races"} with live odds` });
		if (c.offices.includes("president")) out.push({ href: `/${c.year}/president/`, label: `${c.year} President`, note: "Who wins, and both nominations" });
		return out;
	});
void menu; // the CMS "primary" menu is no longer rendered; navigation is built here

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const shareImage = image ?? `${Astro.url.origin}/brand/og.jpg`;
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? coreTitle,
	description: metaDescription,
	canonical,
	image: shareImage,
	content,
	seo: { ogImage: shareImage, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
		<link rel="apple-touch-icon" href="/brand/icon-180.png" />
		<meta name="theme-color" content="#11151c" />
		<meta name="color-scheme" content="dark" />
		<link rel="alternate" type="application/rss+xml" title="Parlay the People analysis" href="/rss.xml" />
		<slot name="head" />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
		<!-- Google tag (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H944GGNB62"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-H944GGNB62');
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title brand" aria-label={`${siteTitle} home`}>
					<img src="/brand/mark.png" alt="" width="40" height="40" class="brand-mark" />
					<span class="brand-word"><span>Parlay</span><span>the People</span></span>
				</a>
				<div class="nav-right">
					<div class="nav-links">
						<div class="nav-dd" data-dd>
							<button type="button" class="nav-dd-btn" aria-expanded="false" aria-controls="nav-elections">USA Elections<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
							<div class="nav-dd-menu" id="nav-elections">
								{electionLinks.map((l) => <a href={l.href}><b>{l.label}</b><span>{l.note}</span></a>)}
								<a href="/elections/"><b>All elections</b><span>Every cycle, office and race</span></a>
								<a href="/results/2026/"><b>Election night</b><span>Races as the markets call them</span></a>
								<a href="/calendar/"><b>Calendar</b><span>Election days, runoffs and deadlines</span></a>
								<a href="/states/"><b>States</b><span>Every race and ballot measure, by state</span></a>
								<a href="/compare/"><b>Compare races</b><span>Line up odds, money and polls</span></a>
								<a href="/candidates/"><b>Candidates</b><span>Every candidate's odds, money and buzz</span></a>
								<a href="/daily/"><b>Daily market report</b><span>What moved the election markets today</span></a>
							</div>
						</div>
						<a href="/politics/">Politics</a>
						<a href="/finance/">Money</a>
						<a href="/voting/">Voting</a>
						<a href="/posts">Analysis</a>
					</div>
				</div>
				<div class="nav-end">
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								Admin
							</a>
						)
					}
					<a href="/account/" class="nav-acct" data-acct title="Free account: join the discussions, follow races, get alerts">Join free</a>
					<a href="/pro/" class="nav-pro" data-nav-pro>Pro</a>
					<SearchOverlay />
					<CountrySwitcher />
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<section class="partners" aria-label="Data partner">
			<div class="partners-inner">
				<span class="partners-lab">Data partner</span>
				<a class="pt" href="https://lunarcrush.com/?utm_source=parlaythepeople&utm_medium=referral&utm_campaign=data_partner" target="_blank" rel="noopener" aria-label="LunarCrush"><img src="/brand/partners/lunarcrush.svg" alt="LunarCrush" width="571" height="136" /></a>
				<span class="partners-note">The Pulse, our social buzz and sentiment data, is powered by LunarCrush. <a href="/guide/#the-pulse">How it works</a></span>
			</div>
		</section>
		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo">
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										class="footer-logo-img"
									/>
								) : (
									siteTitle
								)
							}
						</a>
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">Navigate</h2>
						<ul class="footer-links">
							{electionLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
							<li><a href="/elections/">All elections</a></li>
							<li><a href="/politics/">Politics</a></li>
							<li><a href="/posts">Analysis</a></li>
						</ul>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">Connect</h2>
						<ul class="footer-links">
							<li><a href="/rss.xml">RSS feed</a></li>
							<li><a href="/data/">Data &amp; API</a></li>
							<li><a href="/daily/">Daily report</a></li>
							<li><a href="/model/">Our model</a></li>
							<li><a href="/track-record/">Track record</a></li>
							<li><a href="/forecasters/">Forecasters</a></li>
							<li><a href="/guide/">Guide</a></li>
							<li><a href="/methodology/">Methodology</a></li>
							<li><a href="/pro/">Pro</a></li>
							<li><a href="/account/">Account</a></li>
						</ul>
					</div>
					<div class="footer-widgets-section">
						<WidgetArea name="footer" />
					</div>
				</div>
				<div class="footer-bottom">
					<div class="footer-meta">
						<p class="footer-copyright">
							Market data from <a href="https://kalshi.com">Kalshi</a> and <a href="https://polymarket.com">Polymarket</a>. Not affiliated with either exchange. Not betting or investment advice.
						</p>
					</div>
					{/* Theme switcher removed: the site is dark-only for now (see theme.css). */}
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 65%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-6);
				height: var(--nav-height);
			}

			.site-title {
				font-size: var(--font-size-lg);
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.site-title:hover {
				color: var(--color-brand);
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
				margin-inline-start: auto;
			}

			.nav-links {
				display: flex;
				gap: var(--spacing-5);
				font-size: var(--font-size-sm);
			}

			.nav-links a {
				text-decoration: none;
				color: var(--color-text);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-brand);
			}

			/* USA Elections menu: opens on hover, keyboard focus or tap */
			.nav-dd { position: relative; }
			.nav-dd-btn { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; color: var(--color-text); font-size: var(--font-size-sm); }
			.nav-dd-btn:hover { color: var(--color-brand); }
			.nav-dd-btn:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; border-radius: 4px; }
			.nav-dd-btn svg { transition: transform .2s; }
			.nav-dd-menu { position: absolute; top: calc(100% + 10px); left: -14px; z-index: 50; display: none; min-width: 290px; padding: 8px; border-radius: 12px;
				background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 18px 40px rgb(0 0 0 / .45); }
			.nav-dd-menu::before { content: ""; position: absolute; inset: -12px 0 auto; height: 12px; }
			.nav-dd:hover .nav-dd-menu, .nav-dd:focus-within .nav-dd-menu, .nav-dd[data-open] .nav-dd-menu { display: grid; gap: 2px; }
			.nav-dd:hover .nav-dd-btn svg, .nav-dd[data-open] .nav-dd-btn svg { transform: rotate(180deg); }
			.nav-dd-menu a { display: grid; gap: 1px; padding: 8px 10px; border-radius: 8px; }
			.nav-dd-menu a:hover { background: rgb(255 255 255 / .05); color: var(--color-text); }
			.nav-dd-menu b { font-weight: 600; font-size: 14px; }
			.nav-dd-menu span { font-size: 12px; color: var(--color-muted); }
			@media (max-width: 760px) { .nav-dd-menu { left: 0; min-width: min(290px, calc(100vw - 32px)); } }

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.nav-acct {
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
				white-space: nowrap;
			}
			.nav-acct:hover {
				color: var(--color-text);
			}
			.nav-pro {
				font-family: var(--font-mono), monospace;
				font-size: 12px;
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding: 5px 10px;
				border-radius: 6px;
				border: 1px solid #a3262a;
				color: var(--color-text);
				text-decoration: none;
				white-space: nowrap;
			}
			.nav-pro:hover {
				background: #a3262a;
				color: #fff;
			}
			.nav-admin:hover {
				color: var(--color-text);
			}

			/* Search styling */
			.site-search {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-brand);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
