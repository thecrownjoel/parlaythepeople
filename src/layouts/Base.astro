		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input",
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});
		</script>
		<ExchangeBrands />
		<script>
			// USA Elections menu: tap to open on touch screens; Escape or a tap elsewhere closes it
			for (const dd of document.querySelectorAll<HTMLElement>("[data-dd]")) {
				const btn = dd.querySelector<HTMLButtonElement>(".nav-dd-btn")!;
				const set = (open: boolean) => { open ? dd.setAttribute("data-open", "") : dd.removeAttribute("data-open"); btn.setAttribute("aria-expanded", String(open)); };
				btn.addEventListener("click", () => set(!dd.hasAttribute("data-open")));
				document.addEventListener("click", (e) => { if (!dd.contains(e.target as Node)) set(false); });
				dd.addEventListener("keydown", (e) => { if (e.key === "Escape") { set(false); btn.focus(); } });
			}
		</script>
		<script>
			// What this viewer's plan opens (marks locked controls with a lock; the server enforces every gate).
			(async () => {
				// Pro: replace each "more trades" gate with the real rows (the server checks the plan again)
				const fill = () => {
					if (document.documentElement.dataset.archive !== "1") return;
					for (const el of document.querySelectorAll<HTMLElement>("[data-more-trades]:not([data-filled])")) {
						el.dataset.filled = "1";
						const q = el.dataset.race ? `race=${encodeURIComponent(el.dataset.race)}` : `since=${el.dataset.since}`;
						fetch(`/api/pro/trades?${q}`).then((r) => (r.ok ? r.text() : null)).then((html) => {
							if (html == null) return;
							el.innerHTML = el.dataset.kind === "race" ? `<ol>${html}</ol>` : html;
						}).catch(() => {});
					}
				};
				new MutationObserver(fill).observe(document.body, { childList: true, subtree: true });
				// Closing a Pro card: in a homepage section or a chart, go back to its free default view; elsewhere, drop the card.
				document.addEventListener("click", (e) => {
					const x = (e.target as HTMLElement).closest("[data-gate-close]");
					if (!x) return;
					const gate = x.closest<HTMLElement>(".gate");
					const section = gate?.closest("[data-period-section]");
					const chart = gate?.closest("[data-chart], [data-multichart]");
					const back = section?.querySelector<HTMLElement>("[data-pp] button[data-p]:not([data-lock])")
						?? chart?.querySelector<HTMLElement>("button[data-range]:not([data-lock])");
					if (back) back.click();
					else gate?.remove();
				});
				type Me = { plan: string; signedIn: boolean; history: string; archive: boolean };
				const set = (j: Me) => {
					document.documentElement.dataset.history = j.history;
					document.documentElement.dataset.archive = j.archive ? "1" : "0";
					// header: "Join free" becomes "Account"; members of a paid plan don't need the Pro link
					const acct = document.querySelector<HTMLElement>("[data-acct]");
					if (acct && j.signedIn) acct.textContent = "Account";
					const pro = document.querySelector<HTMLElement>("[data-nav-pro]");
					if (pro && j.plan !== "anon" && j.plan !== "free") pro.hidden = true;
					fill();
				};
				// the account page is where signing in and out lands, so it always asks fresh
				const fresh = location.pathname.startsWith("/account");
				try {
					const hit = JSON.parse(sessionStorage.getItem("ptp:me") || "null");
					if (!fresh && hit && "signedIn" in hit.v && Date.now() - hit.t < 5 * 60_000) return set(hit.v);
				} catch { /* storage blocked */ }
				try {
					const v = (await (await fetch("/api/me")).json()) as Me;
					set(v);
					try { sessionStorage.setItem("ptp:me", JSON.stringify({ t: Date.now(), v })); } catch { /* storage blocked */ }
				} catch { /* offline */ }
			})();
		</script>
		<script>
			// Every dollar amount on the page is green: wrap "$9.5M", "$1,240", "$0.41" in .usd, now and in anything
			// added later (date-picker sections, live trades, analyst answers).
			const MONEY = /[−-]?\$\d[\d,]*(?:\.\d+)?(?:\s?(?:[KMBT]\b|k\b|million|billion))?/g;
			const SKIP = "script,style,textarea,input,select,option,noscript,title,svg,code,pre,.usd,button,.gate-btn,.pro-btn";
			function greenMoney(root: Node) {
				const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
					acceptNode: (n) => (n.nodeValue?.includes("$") && !(n.parentElement?.closest(SKIP)) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT),
				});
				const hits: Text[] = [];
				while (walker.nextNode()) hits.push(walker.currentNode as Text);
				for (const t of hits) {
					const s = t.nodeValue!;
					MONEY.lastIndex = 0;
					if (!MONEY.test(s)) continue;
					MONEY.lastIndex = 0;
					const frag = document.createDocumentFragment();
					let at = 0;
					for (const m of s.matchAll(MONEY)) {
						if (m.index! > at) frag.append(s.slice(at, m.index));
						const span = document.createElement("span");
						span.className = "usd";
						span.textContent = m[0];
						frag.append(span);
						at = m.index! + m[0].length;
					}
					frag.append(s.slice(at));
					t.replaceWith(frag);
				}
			}
			greenMoney(document.body);
			// batch what was added each frame; wrapping only adds nodes inside .usd, which greenMoney skips
			const pending = new Set<Node>();
			let queued = false;
			new MutationObserver((records) => {
				for (const r of records) for (const n of r.addedNodes) if (n.nodeType === 1 || n.nodeType === 3) pending.add(n.nodeType === 3 ? n.parentNode ?? n : n);
				if (queued || !pending.size) return;
				queued = true;
				requestAnimationFrame(() => {
					queued = false;
					for (const n of pending) if (n.isConnected) greenMoney(n);
					pending.clear();
				});
			}).observe(document.body, { childList: true, subtree: true });
		</script>
		<script>
			// Followed races: once per browser session, merge this browser's list with the signed-in account's, both ways.
			(async () => {
				try {
					if (sessionStorage.getItem("ptp:synced")) return;
					sessionStorage.setItem("ptp:synced", "1");
					const r = await fetch("/api/watchlist");
					const j = (await r.json()) as { signed_in: boolean; races: { race_id: string; name: string | null }[] };
					if (!j.signed_in) return;
					const local: Record<string, { name: string; D?: number; ts: number }> = JSON.parse(localStorage.getItem("ptp:follow") || "{}");
					const server = new Set(j.races.map((x) => x.race_id));
					for (const x of j.races) if (!local[x.race_id]) local[x.race_id] = { name: x.name ?? x.race_id, ts: Date.now() };
					localStorage.setItem("ptp:follow", JSON.stringify(local));
					const missing = Object.entries(local).filter(([id]) => !server.has(id)).map(([race_id, v]) => ({ race_id, name: v.name }));
					if (missing.length) await fetch("/api/watchlist", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ on: true, races: missing }) });
				} catch { /* storage blocked or offline: following stays per browser */ }
			})();
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
