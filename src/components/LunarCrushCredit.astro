---
/** "Social data by LunarCrush" credit with their logo; links with partner UTM tags. */
import { LUNARCRUSH_URL } from "../lib/social";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<a class:list={["lc-credit", { compact }]} href={LUNARCRUSH_URL} target="_blank" rel="noopener" aria-label="Social data by LunarCrush">
	<span>Social data by</span><img src="/brand/partners/lunarcrush.svg" alt="LunarCrush" width="571" height="136" />
</a>
<style>
	.lc-credit { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--color-muted); font-size: 12.5px; }
	.lc-credit img { height: 20px; width: auto; display: block; opacity: .92; }
	.lc-credit:hover img { opacity: 1; }
	.lc-credit.compact img { height: 15px; }
	.lc-credit.compact { font-size: 11.5px; }
</style>
