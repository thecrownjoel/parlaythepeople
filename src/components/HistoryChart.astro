---
/**
 * Price-history chart with range buttons (24H · 1W · 1M · 3M · 1Y · All).
 * The default range is rendered on the server; other ranges load from /api/v1/chart/<race>.
 */
import type { CycleData } from "../lib/markets";
import { latestPoint } from "../lib/markets";
import { RANGES, DEFAULT_RANGE, rangeOf, getSeries, renderChart, describeMove } from "../lib/chart";
interface Props { raceId: string; data: CycleData; party?: "D" | "R"; label?: string }
const { raceId, data, party = "D", label = party === "R" ? "Republican odds" : "Democratic odds" } = Astro.props;
const range = rangeOf(DEFAULT_RANGE);
const latest = latestPoint(data, raceId);
const points = await getSeries(raceId, range, latest);
const opts = { party, label, range, electionDay: data.meta.election_day } as const;
const body = `<p class="hc-move">${describeMove(points, opts)}</p>${renderChart(points, opts)}`;
---
<div class="hc-wrap" data-chart={raceId} data-party={party}>
	<div class="hc-ranges" role="group" aria-label="Chart time range">
		{RANGES.map((r) => (
			<button type="button" data-range={r.key} aria-pressed={r.key === range.key ? "true" : "false"} title={`Show ${r.words}`}>{r.label}</button>
		))}
	</div>
	<div class="hc-body" data-chart-body aria-live="polite" set:html={body} />
</div>

<script>
	for (const wrap of document.querySelectorAll<HTMLElement>("[data-chart]")) {
		const body = wrap.querySelector<HTMLElement>("[data-chart-body]")!;
		const cache = new Map<string, string>([[wrap.querySelector('[aria-pressed="true"]')?.getAttribute("data-range") ?? "", body.innerHTML]]);
		wrap.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((btn) =>
			btn.addEventListener("click", async () => {
				const key = btn.dataset.range!;
				wrap.querySelectorAll("[data-range]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
				if (!cache.has(key)) {
					body.classList.add("hc-loading");
					try {
						const r = await fetch(`/api/v1/chart/${wrap.dataset.chart}?range=${key}&party=${wrap.dataset.party}`);
						cache.set(key, r.ok ? await r.text() : `<p class="hc-empty">Couldn't load this range. Try again in a moment.</p>`);
					} catch {
						cache.set(key, `<p class="hc-empty">Couldn't load this range. Check your connection and try again.</p>`);
					}
					body.classList.remove("hc-loading");
				}
				body.innerHTML = cache.get(key)!;
			}),
		);
	}
</script>

<style>
	.hc-ranges { display: inline-flex; gap: 2px; padding: 3px; background: var(--bt-chip); border-radius: 8px; margin-bottom: 12px; flex-wrap: wrap; }
	.hc-ranges button { all: unset; cursor: pointer; padding: 5px 11px; border-radius: 6px; font-size: 13px; font-weight: 600; color: var(--color-text-secondary); font-family: var(--font-mono), monospace; }
	.hc-ranges button:hover { color: var(--color-text); }
	.hc-ranges button[aria-pressed="true"] { background: var(--color-surface); color: var(--color-text); box-shadow: 0 1px 2px rgb(0 0 0 / 0.12); }
	.hc-ranges button:focus-visible { outline: 2px solid var(--color-text); outline-offset: 1px; }
	.hc-body { transition: opacity 0.15s; }
	.hc-body.hc-loading { opacity: 0.45; }
	.hc-body :global(.hc-move) { margin: 0 0 10px; font-size: 14px; color: var(--color-text-secondary); }
	.hc-body :global(.hc) { margin: 0; }
	.hc-body :global(.hc-plot) { position: relative; height: 240px; margin: 8px 0 26px 40px; }
	.hc-body :global(.hc-plot svg) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
	.hc-body :global(.hc-grid) { stroke: var(--color-border); stroke-width: 1; }
	.hc-body :global(.hc-mid) { stroke: var(--color-muted); stroke-width: 1; stroke-dasharray: 3 3; }
	.hc-body :global(.hc-y), .hc-body :global(.hc-x) { position: absolute; font: 11.5px var(--font-mono), monospace; color: var(--color-muted); white-space: nowrap; }
	.hc-body :global(.hc-y) { left: -40px; width: 34px; text-align: right; transform: translateY(-50%); }
	.hc-body :global(.hc-x) { top: calc(100% + 6px); }
	.hc-body :global(.hc-x1) { transform: translateX(-50%); }
	.hc-body :global(.hc-x2) { transform: translateX(-100%); }
	.hc-body :global(.hc-ed) { stroke: #a3262a; stroke-width: 1.5; stroke-dasharray: 4 3; }
	.hc-body :global(.hc-edl) { position: absolute; top: 2px; margin-left: 5px; font: 600 11.5px var(--font-body), sans-serif; color: #a3262a; white-space: nowrap; }
	.hc-body :global(.hc-edl-r) { transform: translateX(-100%); margin-left: -5px; }
	@media (max-width: 640px) { .hc-body :global(.hc-plot) { height: 190px; } }
	.hc-body :global(.hc-legend) { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--color-text-secondary); margin-top: 6px; }
	.hc-body :global(.hc-legend span) { display: inline-flex; align-items: center; gap: 6px; }
	.hc-body :global(.hc-solid), .hc-body :global(.hc-dash) { width: 18px; height: 0; border-top: 2px solid; display: inline-block; }
	.hc-body :global(.hc-dash) { border-top-style: dashed; }
	.hc-body :global(.hc-empty) { color: var(--color-text-secondary); font-size: 14px; margin: 0; }
	@media (prefers-reduced-motion: reduce) { .hc-body { transition: none; } }
</style>
