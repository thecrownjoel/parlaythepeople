---
/**
 * Server-rendered line chart of a race's Democratic odds over time, one line per exchange.
 * No JavaScript: readable by crawlers and by readers with scripts off.
 */
import type { HistoryPoint } from "../lib/markets";
interface Props { points: HistoryPoint[]; label?: string; party?: "D" | "R" }
const { points, label = "Democratic odds", party = "D" } = Astro.props;
const W = 720, H = 240, L = 40, R = 12, T = 12, B = 28;
const key = party === "D" ? (["k_d", "p_d"] as const) : (["k_r", "p_r"] as const);
const pts = points.filter((p) => p[key[0]] != null || p[key[1]] != null);
const t0 = pts.length ? pts[0].ts : 0, t1 = pts.length ? pts[pts.length - 1].ts : 1;
const x = (t: number) => L + ((t - t0) / Math.max(1, t1 - t0)) * (W - L - R);
const y = (v: number) => T + (1 - v) * (H - T - B);
const line = (f: "k_d" | "p_d" | "k_r" | "p_r") => {
	let d = "", pen = false;
	for (const p of pts) {
		const v = p[f];
		if (v == null) { pen = false; continue; }
		d += `${pen ? "L" : "M"}${x(p.ts).toFixed(1)},${y(v).toFixed(1)}`;
		pen = true;
	}
	return d;
};
const fmt = (t: number) => new Date(t * 1000).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "America/New_York" });
const ticks = pts.length > 1 ? [t0, t0 + (t1 - t0) / 2, t1] : [];
const last = pts[pts.length - 1];
const color = party === "D" ? "var(--bt-d)" : "var(--bt-r)";
---
{pts.length < 2 ? (
	<p class="hc-empty">Price history starts with the first collection on {pts.length ? fmt(pts[0].ts) : "the next update"}; the chart fills in as new prices are recorded every 10 minutes.</p>
) : (
	<figure class="hc">
		<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label} over time: Kalshi ${last?.[key[0]] != null ? Math.round(last[key[0]]! * 100) + "%" : "n/a"}, Polymarket ${last?.[key[1]] != null ? Math.round(last[key[1]]! * 100) + "%" : "n/a"} most recently`}>
			{[0, 0.25, 0.5, 0.75, 1].map((v) => (
				<g>
					<line x1={L} x2={W - R} y1={y(v)} y2={y(v)} class={v === 0.5 ? "hc-mid" : "hc-grid"} />
					<text x={L - 6} y={y(v) + 4} text-anchor="end" class="hc-lab">{Math.round(v * 100)}%</text>
				</g>
			))}
			{ticks.map((t, i) => (
				<text x={x(t)} y={H - 8} text-anchor={i === 0 ? "start" : i === ticks.length - 1 ? "end" : "middle"} class="hc-lab">{fmt(t)}</text>
			))}
			<path d={line(key[1])} fill="none" stroke={color} stroke-width="2" stroke-dasharray="5 4" opacity="0.8" />
			<path d={line(key[0])} fill="none" stroke={color} stroke-width="2" />
		</svg>
		<figcaption class="hc-legend">
			<span><i class="hc-solid" style={`border-color:${color}`}></i>Kalshi</span>
			<span><i class="hc-dash" style={`border-color:${color}`}></i>Polymarket</span>
			<span>{label}, {fmt(t0)} – {fmt(t1)}</span>
		</figcaption>
	</figure>
)}
<style>
	.hc { margin: 0; }
	.hc svg { width: 100%; height: auto; display: block; }
	.hc-grid { stroke: var(--color-border); stroke-width: 1; }
	.hc-mid { stroke: var(--color-muted); stroke-width: 1; stroke-dasharray: 3 3; }
	.hc-lab { fill: var(--color-muted); font: 11px var(--font-mono), monospace; }
	.hc-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--color-text-secondary); margin-top: 6px; }
	.hc-legend span { display: inline-flex; align-items: center; gap: 6px; }
	.hc-solid, .hc-dash { width: 18px; height: 0; border-top: 2px solid; display: inline-block; }
	.hc-dash { border-top-style: dashed; }
	.hc-empty { color: var(--color-text-secondary); font-size: 14px; margin: 0; }
</style>
