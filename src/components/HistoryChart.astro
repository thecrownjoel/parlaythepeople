---
/**
 * Price-history chart with range buttons (24H · 1W · 1M · 3M · 1Y · All).
 * The default range is rendered on the server; other ranges load from /api/v1/chart/<race>.
 */
import type { CycleData } from "../lib/markets";
import { latestPoint } from "../lib/markets";
import { RANGES, DEFAULT_RANGE, rangeOf, getSeries, renderChart, describeMove } from "../lib/chart";
import "../styles/charts.css";
interface Props { raceId: string; data: CycleData; party?: "D" | "R"; label?: string }
const { raceId, data, party = "D", label = party === "R" ? "Republican odds" : "Democratic odds" } = Astro.props;
const range = rangeOf(DEFAULT_RANGE);
const latest = latestPoint(data, raceId);
const points = await getSeries(raceId, range, latest);
const opts = { party, label, range, electionDay: data.meta.election_day } as const;
const body = `<p class="hc-move">${describeMove(points, opts)}</p>${renderChart(points, opts)}`;
---
<div class="hc-wrap" data-chart={raceId} data-party={party}>
	<div class="hc-ranges" role="group" aria-label="Chart time range">
		{RANGES.map((r) => (
			<button type="button" data-range={r.key} aria-pressed={r.key === range.key ? "true" : "false"} title={`Show ${r.words}`}>{r.label}</button>
		))}
	</div>
	<div class="hc-body" data-chart-body aria-live="polite" set:html={body} />
</div>

<script>
	for (const wrap of document.querySelectorAll<HTMLElement>("[data-chart]")) {
		const body = wrap.querySelector<HTMLElement>("[data-chart-body]")!;
		const cache = new Map<string, string>([[wrap.querySelector('[aria-pressed="true"]')?.getAttribute("data-range") ?? "", body.innerHTML]]);
		wrap.querySelectorAll<HTMLButtonElement>("[data-range]").forEach((btn) =>
			btn.addEventListener("click", async () => {
				const key = btn.dataset.range!;
				wrap.querySelectorAll("[data-range]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
				if (!cache.has(key)) {
					body.classList.add("hc-loading");
					try {
						const r = await fetch(`/api/v1/chart/${wrap.dataset.chart}?range=${key}&party=${wrap.dataset.party}`);
						cache.set(key, r.ok ? await r.text() : `<p class="hc-empty">Couldn't load this range. Try again in a moment.</p>`);
					} catch {
						cache.set(key, `<p class="hc-empty">Couldn't load this range. Check your connection and try again.</p>`);
					}
					body.classList.remove("hc-loading");
				}
				body.innerHTML = cache.get(key)!;
			}),
		);
	}
</script>
