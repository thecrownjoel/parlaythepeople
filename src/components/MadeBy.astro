---
/** Footer credit: "Built by 45press". The logo follows the footer's text color in both themes. */
import logo from "../assets/45p-logo.svg?raw";
---
<a class="made-by" href="https://45press.com" rel="noopener" target="_blank" aria-label="Built by 45press">
	<span>Built by</span><span class="made-by-logo" set:html={logo} />
</a>
<style>
	.made-by { display: inline-flex; align-items: center; gap: 7px; font-size: var(--font-size-sm); color: var(--color-text-secondary); text-decoration: none; }
	.made-by:hover { color: var(--color-text); }
	.made-by-logo { display: inline-flex; height: 20px; }
	.made-by-logo :global(svg) { height: 100%; width: auto; display: block; }
	/* The letters are the "paper" shapes; the "ink" shapes are their 3D extrusion. */
	.made-by-logo :global(.paper) { fill: currentColor; }
	.made-by-logo :global(.ink) { fill: color-mix(in srgb, currentColor 30%, transparent); }
</style>
