  --line:var(--color-border); --line-2:light-dark(#ced3dc,#323a46); --hover:var(--bt-hover);
  --d:var(--bt-d); --r:var(--bt-r); --oth:var(--bt-oth); --toss:var(--bt-toss); --pos:var(--bt-pos); --neg:light-dark(#b23a2e,#f07a6c); --chip:var(--bt-chip);
  --f-display:var(--font-display),"Arial Narrow",sans-serif; --f-body:var(--font-body),system-ui,sans-serif; --f-mono:var(--font-mono),ui-monospace,monospace;
  display:flex;flex-direction:column;gap:28px;font-family:var(--f-body);font-size:14px;line-height:1.45;color:var(--ink);
