---
/** The politics board (every other politics market), for /politics/ and each topic page /politics/<topic>/. */
import { politicsSparks, newListings, sparkPath, money, TOPIC_COLOR, TOPIC_SLUG, type PolEvent, type PolBoard } from "../lib/politics";
import "../styles/data.css";

interface Props { board: PolBoard | null; topic?: string }
const { board, topic } = Astro.props;
// on a topic page, the board is that topic's markets only
const events = (board?.events ?? []).filter((e) => !topic || e.topic === topic);
const topicInfo = topic ? board?.topics.find((t) => t.key === topic) : null;
const fresh = board ? (await newListings(board)).filter((e) => !topic || e.topic === topic) : [];
// cards for each topic's busiest markets; on a topic page every other market follows in a compact list
const SHOW = topic ? 60 : 24;
const pct = (p: number) => (p >= 0.995 ? ">99%" : p < 0.005 ? "<1%" : `${Math.round(p * 100)}%`);
const pts = (d: number | null) => (d == null || Math.abs(d) < 0.005 ? "" : `${d > 0 ? "▲" : "▼"} ${Math.abs(Math.round(d * 100))}`);
const ends = (iso: string | null) => (iso && /^\d{4}-\d{2}-\d{2}/.test(iso) && iso < "9999" ? new Date(`${iso.slice(0, 10)}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }) : null);
const byTopic = (board?.topics ?? []).filter((t) => !topic || t.key === topic).map((t) => ({ ...t, color: TOPIC_COLOR[t.key] ?? "#9aa1ad", events: events.filter((e) => e.topic === t.key) }));
const sparks = await politicsSparks(byTopic.flatMap((t) => t.events.slice(0, SHOW).map((e) => e.id)));
const topicName = new Map((board?.topics ?? []).map((t) => [t.key, t.name]));
// the ticker: biggest 24-hour moves in a leading outcome
const movers = [...events].filter((e) => e.o[0].d != null && Math.abs(e.o[0].d!) >= 0.02 && e.vol24 > 2000).sort((a, b) => Math.abs(b.o[0].d!) - Math.abs(a.o[0].d!)).slice(0, 16);
// the bubble field: the most money in the last 24 hours, packed on a spiral around the centre
const BW = 1100, BH = 440;
const top = [...events].filter((e) => e.vol24 > 0).sort((a, b) => b.vol24 - a.vol24).slice(0, 34);
const maxV = Math.sqrt(top[0]?.vol24 ?? 1);
const bubbles: { e: PolEvent; x: number; y: number; r: number }[] = [];
for (const e of top) {
	const r = 26 + (Math.sqrt(e.vol24) / maxV) * 62;
	for (let t = 0; t < 2400; t += 1) {
		const a = t * 0.31, d = 2.1 * t ** 0.62;
		const x = BW / 2 + Math.cos(a) * d * 1.9, y = BH / 2 + Math.sin(a) * d;
		if (x - r < 4 || x + r > BW - 4 || y - r < 4 || y + r > BH - 4) continue;
		if (bubbles.every((b) => Math.hypot(b.x - x, b.y - y) > b.r + r + 6)) { bubbles.push({ e, x, y, r }); break; }
	}
}
const updated = board ? new Date(board.generated).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZone: "America/New_York" }) + " ET" : "";
---
	<div class="pol">
		<header class="pol-hero">
			<div class="pol-orbs" aria-hidden="true"><i></i><i></i><i></i></div>
			<p class="eyebrow pol-eyebrow">{topicInfo ? <a href="/politics/" style="color:inherit">Politics</a> : "Beyond the ballot"}</p>
			<h1 class="pol-title" data-split>{topicInfo ? `${topicInfo.name}: the odds` : "Everything else politics is betting on"}</h1>
			<p class="pol-lede">{topicInfo
				? `Every ${topicInfo.name.toLowerCase()} market on Kalshi and Polymarket: ${events.length} markets with live odds, money traded and the last 24 hours, updated every 10 minutes.`
				: "Cabinet picks, the Supreme Court, shutdowns, approval ratings, world leaders, mayors and more: every other politics market on Kalshi and Polymarket, side by side, updated every 10 minutes."}</p>
			{board && (
				<dl class="pol-stats">
					<div><dt>Markets</dt><dd data-count={events.length}>{events.length}</dd></div>
					<div><dt>Traded today</dt><dd data-count={events.reduce((a, e) => a + e.vol24, 0)} data-money>{money(events.reduce((a, e) => a + e.vol24, 0))}</dd></div>
					<div><dt>Traded all time</dt><dd data-count={events.reduce((a, e) => a + e.vol, 0)} data-money>{money(events.reduce((a, e) => a + e.vol, 0))}</dd></div>
					<div><dt>{topicInfo ? "On Kalshi / Polymarket" : "Topics"}</dt><dd>{topicInfo ? `${events.filter((e) => e.src === "k").length} / ${events.filter((e) => e.src === "p").length}` : board.topics.length}</dd></div>
				</dl>
			)}
			{updated && <p class="pol-updated">Updated {updated}</p>}
		</header>

		{!board && <p class="sec-note">The politics board is being collected. Check back in a few minutes.</p>}

		{movers.length > 0 && (
			<section class="pol-marquee" aria-label="Biggest moves in the last 24 hours">
				<div class="pol-track" data-track>
					{[0, 1].map((copy) => movers.map((e) => (
						<a class="pol-tick" href={`#e-${e.id.replace(/[^a-z0-9]/gi, "-")}`} aria-hidden={copy ? "true" : undefined} tabindex={copy ? -1 : undefined}>
							<span class="pol-tick-t">{e.title}</span>
							<b>{e.multi ? `${e.o[0].n} ` : ""}{pct(e.o[0].p)}</b>
							<em class={e.o[0].d! > 0 ? "up" : "down"}>{pts(e.o[0].d)}</em>
						</a>
					)))}
				</div>
			</section>
		)}

		{bubbles.length > 0 && (
			<section class="pol-field-wrap" aria-labelledby="field-h">
				<div class="sec-head"><h2 id="field-h">Where the money is today</h2><p class="sec-note" style="margin:0">Each bubble is a market, sized by dollars traded in the last 24 hours</p></div>
				<div class="pol-field" style={`aspect-ratio:${BW}/${BH}`}>
					{bubbles.map((b) => (
						<a class="pol-bub" href={`#e-${b.e.id.replace(/[^a-z0-9]/gi, "-")}`} style={`left:${(b.x / BW) * 100}%;top:${(b.y / BH) * 100}%;width:${((b.r * 2) / BW) * 100}%;--tc:${TOPIC_COLOR[b.e.topic] ?? "#9aa1ad"}`} title={`${b.e.title}: ${money(b.e.vol24)} today`}>
							<span class="pol-bub-in">
								<b>{pct(b.e.o[0].p)}</b>
								{b.r > 44 && <span class="pol-bub-t">{b.e.multi ? b.e.o[0].n : b.e.title}</span>}
							</span>
						</a>
					))}
				</div>
				<p class="pol-legend">{(board?.topics ?? []).map((t) => <span><i style={`background:${TOPIC_COLOR[t.key] ?? "#9aa1ad"}`}></i>{t.name}</span>)}</p>
			</section>
		)}

		{fresh.length > 0 && (
			<section aria-labelledby="new-h">
				<div class="sec-head"><h2 id="new-h">Just listed</h2><p class="sec-note" style="margin:0">Markets that opened in the last three days</p></div>
				<div class="pol-new">
					{fresh.map((e) => <a class="pol-new-c" href={e.url} rel="noopener nofollow" target="_blank" style={`--tc:${TOPIC_COLOR[e.topic] ?? "#9aa1ad"}`}><span class="pol-new-badge">New</span><span>{e.title}</span><b>{e.multi ? `${e.o[0].n} ${pct(e.o[0].p)}` : pct(e.o[0].p)}</b></a>)}
				</div>
			</section>
		)}

		{board && !topic && (
			<nav class="pol-chips" aria-label="Topics" data-chips>
				<button type="button" aria-pressed="true" data-filter="all">All <span>{board.totals.events}</span></button>
				{byTopic.map((t) => <button type="button" aria-pressed="false" data-filter={t.key} style={`--tc:${t.color}`}><i></i>{t.name} <span>{t.count}</span></button>)}
			</nav>
		)}
		{board && topic && (
			<nav class="pol-chips" aria-label="Topics">
				<a href="/politics/">All <span>{board.totals.events}</span></a>
				{board.topics.map((t) => <a href={`/politics/${TOPIC_SLUG[t.key] ?? t.key}/`} aria-current={t.key === topic ? "page" : undefined} style={`--tc:${TOPIC_COLOR[t.key] ?? "#9aa1ad"}`}><i></i>{t.name} <span>{t.count}</span></a>)}
			</nav>
		)}

		<div class="pol-topics" data-topics>
			{byTopic.map((t) => (
				<section class="pol-topic" data-topic={t.key} style={`--tc:${t.color}`} aria-labelledby={`t-${t.key}`}>
					<div class="pol-topic-head">
						<h2 id={`t-${t.key}`}><i></i>{t.name}</h2>
						<p>{t.count} markets · {money(t.events.reduce((a, e) => a + e.vol24, 0))} today{!topic && <> · <a href={`/politics/${TOPIC_SLUG[t.key] ?? t.key}/`}>Open the {t.name.toLowerCase()} page →</a></>}</p>
					</div>
					<div class="pol-grid">
						{t.events.slice(0, SHOW).map((e) => {
							const sp = sparks.get(e.id) ?? [];
							const lead = e.o[0];
							return (
								<article class="pc" id={`e-${e.id.replace(/[^a-z0-9]/gi, "-")}`}>
									<div class="pc-top">
										<span class={`pc-src pc-${e.src}`}>{e.src === "k" ? "Kalshi" : "Polymarket"}</span>
										{lead.d != null && Math.abs(lead.d) >= 0.005 && <span class={`pc-move ${lead.d > 0 ? "up" : "down"}`}>{pts(lead.d)} pts</span>}
									</div>
									<h3><a href={e.url} rel="noopener nofollow" target="_blank">{e.title}</a></h3>
									{e.sub && <p class="pc-sub">{e.sub}</p>}
									{e.multi ? (
										<ul class="pc-bars">
											{e.o.slice(0, 4).map((o) => <li><span class="pc-n">{o.n}</span><span class="pc-bar"><i style={`--w:${Math.max(1, o.p * 100)}%`}></i></span><b>{pct(o.p)}</b></li>)}
											{e.n_out > 4 && <li class="pc-more">+{e.n_out - 4} more</li>}
										</ul>
									) : (
										<div class="pc-gauge">
											<svg viewBox="0 0 120 70" aria-hidden="true"><path d="M10 64 A50 50 0 0 1 110 64" class="pc-g-bg" pathLength="100" /><path d="M10 64 A50 50 0 0 1 110 64" class="pc-g-fg" pathLength="100" style={`--v:${Math.round(lead.p * 100)}`} /></svg>
											<b>{pct(lead.p)}</b><span>chance of Yes</span>
										</div>
									)}
									<div class="pc-foot">
										{sp.length > 1 ? <svg class="pc-spark" viewBox="0 0 120 32" aria-label="Last 24 hours"><path d={sparkPath(sp)} pathLength="1" /></svg> : <span></span>}
										<span class="pc-vol">{money(e.vol24)} today<br /><span>{money(e.vol)} all time{ends(e.ends) ? ` · ends ${ends(e.ends)}` : ""}</span></span>
									</div>
								</article>
							);
						})}
					</div>
					{t.count > SHOW && !topic && <a class="pol-more" href={`/politics/${TOPIC_SLUG[t.key] ?? t.key}/`}>See all {t.count} {t.name.toLowerCase()} markets</a>}
					{t.count > SHOW && topic && (
						<div class="pol-rest" data-rest>
							<div class="pol-rest-head">
								<h3>Every other {t.name.toLowerCase()} market <span>{t.count - SHOW}</span></h3>
								<input type="search" placeholder="Filter by name" aria-label={`Filter ${t.name.toLowerCase()} markets`} data-rest-filter />
							</div>
							<ol class="pol-list">
								{t.events.slice(SHOW).map((e) => {
									const lead = e.o[0];
									return (
										<li id={`e-${e.id.replace(/[^a-z0-9]/gi, "-")}`}>
											<span class={`pc-src pc-${e.src}`}>{e.src === "k" ? "K" : "P"}</span>
											<a href={e.url} rel="noopener nofollow" target="_blank">{e.title}</a>
											<b>{e.multi ? `${lead.n}: ` : ""}{pct(lead.p)}{e.n_out > 1 ? <span> of {e.n_out}</span> : null}</b>
											<span class="pol-list-vol">{e.vol24 ? `${money(e.vol24)} today · ` : ""}{money(e.vol)} traded</span>
										</li>
									);
								})}
							</ol>
						</div>
					)}
				</section>
			))}
		</div>
		<p class="sec-note" style="font-size:12.5px">Every open market in Kalshi's Politics and Elections categories and Polymarket's politics and elections tags, however thinly traded, except the races covered on our race pages. Prices are each exchange's own (bid/ask midpoint on Kalshi, displayed price on Polymarket). Research, not betting advice.</p>
	</div>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { Flip } from "gsap/Flip";
	import { SplitText } from "gsap/SplitText";
	gsap.registerPlugin(ScrollTrigger, Flip, SplitText);
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const fmtMoney = (x: number) => (x >= 1e9 ? `$${(x / 1e9).toFixed(1)}B` : x >= 1e6 ? `$${(x / 1e6).toFixed(1)}M` : x >= 1e3 ? `$${Math.round(x / 1e3)}K` : `$${Math.round(x)}`);

	// topic pages: filter the full list by name
	document.querySelectorAll<HTMLInputElement>("[data-rest-filter]").forEach((f) => {
		const rows = [...f.closest("[data-rest]")!.querySelectorAll<HTMLElement>(".pol-list li")];
		const text = rows.map((r) => r.textContent!.toLowerCase());
		f.addEventListener("input", () => {
			const q = f.value.trim().toLowerCase();
			rows.forEach((r, i) => (r.hidden = !!q && !text[i].includes(q)));
			ScrollTrigger.refresh();
		});
	});

	// topic filter, animated with Flip
	const chips = document.querySelector("[data-chips]");
	chips?.addEventListener("click", (ev) => {
		const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
		if (!btn) return;
		const key = btn.dataset.filter!;
		chips.querySelectorAll("[data-filter]").forEach((c) => c.setAttribute("aria-pressed", String(c === btn)));
		const sections = [...document.querySelectorAll<HTMLElement>(".pol-topic")];
		const state = Flip.getState(sections);
		sections.forEach((s) => (s.hidden = key !== "all" && s.dataset.topic !== key));
		if (reduce) return;
		Flip.from(state, { duration: 0.6, ease: "power3.inOut", absolute: true, onEnter: (els) => gsap.fromTo(els, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.5 }), onLeave: (els) => gsap.to(els, { opacity: 0, duration: 0.25 }) });
		document.querySelector("[data-topics]")!.scrollIntoView({ behavior: "smooth", block: "start" });
	});

	// cards: fill the gauges and bars, draw the sparklines, as they scroll in (also without motion: just show them filled)
	if (reduce) document.querySelectorAll(".pc").forEach((c) => c.classList.add("in"));

	if (!reduce) {
		// hero: letters rise, counters run, orbs drift
		const title = document.querySelector<HTMLElement>("[data-split]");
		if (title) {
			const split = SplitText.create(title, { type: "words,chars" });
			gsap.from(split.chars, { yPercent: 120, rotate: 8, opacity: 0, duration: 0.8, ease: "back.out(1.6)", stagger: 0.022 });
		}
		gsap.from(".pol-lede, .pol-stats > div, .pol-updated", { y: 24, opacity: 0, duration: 0.7, stagger: 0.08, delay: 0.35, ease: "power3.out" });
		document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
			const to = Number(el.dataset.count), isMoney = el.hasAttribute("data-money"), o = { v: 0 };
			gsap.to(o, { v: to, duration: 1.8, delay: 0.4, ease: "power3.out", onUpdate: () => (el.textContent = isMoney ? fmtMoney(o.v) : Math.round(o.v).toLocaleString("en-US")) });
		});
		document.querySelectorAll<HTMLElement>(".pol-orbs i").forEach((orb, i) => gsap.to(orb, { x: "random(-120, 120)", y: "random(-60, 60)", scale: "random(0.8, 1.3)", duration: "random(6, 10)", repeat: -1, yoyo: true, ease: "sine.inOut", delay: i }));

		// ticker: an endless crawl, slowing under the pointer
		const track = document.querySelector<HTMLElement>("[data-track]");
		if (track) {
			const crawl = gsap.to(track, { xPercent: -50, duration: Math.max(30, track.children.length * 3), ease: "none", repeat: -1 });
			track.addEventListener("pointerenter", () => gsap.to(crawl, { timeScale: 0.15, duration: 0.6 }));
			track.addEventListener("pointerleave", () => gsap.to(crawl, { timeScale: 1, duration: 0.6 }));
		}

		// bubbles: pop in when the field scrolls into view, then float
		const bubs = gsap.utils.toArray<HTMLElement>(".pol-bub");
		gsap.from(bubs, { scale: 0, opacity: 0, duration: 0.9, ease: "elastic.out(1, 0.55)", stagger: { each: 0.035, from: "center" }, scrollTrigger: { trigger: ".pol-field", start: "top 80%" } });
		bubs.forEach((b) => gsap.to(b.firstElementChild, { x: "random(-8, 8)", y: "random(-10, 10)", duration: "random(2.5, 4.5)", repeat: -1, yoyo: true, ease: "sine.inOut" }));

		gsap.from(".pol-new-c", { x: 40, opacity: 0, duration: 0.6, stagger: 0.06, ease: "power3.out", scrollTrigger: { trigger: ".pol-new", start: "top 85%" } });
		gsap.from(".pol-chips button", { y: 16, opacity: 0, duration: 0.5, stagger: 0.04, ease: "power2.out", scrollTrigger: { trigger: ".pol-chips", start: "top 90%" } });

		// topic headers sweep in; cards rise in batches and fill their charts
		gsap.utils.toArray<HTMLElement>(".pol-topic-head").forEach((h) => gsap.from(h, { x: -40, opacity: 0, duration: 0.7, ease: "power3.out", scrollTrigger: { trigger: h, start: "top 88%" } }));
		ScrollTrigger.batch(".pc:not([hidden])", {
			start: "top 92%",
			onEnter: (batch) => {
				gsap.from(batch, { y: 44, opacity: 0, rotateX: -12, duration: 0.7, stagger: 0.07, ease: "power3.out", clearProps: "transform,opacity" });
				batch.forEach((c) => c.classList.add("in"));
			},
		});

		// cards tilt toward the pointer
		document.querySelectorAll<HTMLElement>(".pc").forEach((card) => {
			const rx = gsap.quickTo(card, "rotationX", { duration: 0.4, ease: "power3" }), ry = gsap.quickTo(card, "rotationY", { duration: 0.4, ease: "power3" });
			card.addEventListener("pointermove", (e) => { const r = card.getBoundingClientRect(); ry(((e.clientX - r.left) / r.width - 0.5) * 8); rx(-((e.clientY - r.top) / r.height - 0.5) * 8); });
			card.addEventListener("pointerleave", () => { rx(0); ry(0); });
		});
	}
</script>

<style>
	.pol { width: min(1200px, 100% - 32px); margin: 0 auto; padding: 32px 0 64px; display: flex; flex-direction: column; gap: 40px; }
	.pol-hero { position: relative; isolation: isolate; padding: 48px clamp(18px, 4vw, 48px); border-radius: 22px; overflow: hidden; background: #0d1118; border: 1px solid #222a35; }
	.pol-orbs { position: absolute; inset: 0; z-index: -1; filter: blur(60px); opacity: .55; }
	.pol-orbs i { position: absolute; width: 380px; height: 380px; border-radius: 50%; }
	.pol-orbs i:nth-child(1) { background: #a3262a; left: -80px; top: -120px; }
	.pol-orbs i:nth-child(2) { background: #2e62d0; right: -60px; top: 40px; }
	.pol-orbs i:nth-child(3) { background: #4cc3c8; left: 40%; bottom: -220px; opacity: .6; }
	.pol-eyebrow { color: #f08a7e !important; }
	.pol-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(38px, 6.4vw, 78px); line-height: 1; letter-spacing: -.01em; margin: 10px 0 16px; max-width: 14ch; }
	.pol-title :global(.char) { display: inline-block; }
	.pol-lede { font-size: 18px; line-height: 1.5; max-width: 62ch; color: #c9cfd8; margin: 0; }
	.pol-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 28px 0 0; }
	.pol-stats div { background: rgb(255 255 255 / .04); border: 1px solid rgb(255 255 255 / .08); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(6px); }
	.pol-stats dt { font: 600 11.5px var(--font-mono), monospace; letter-spacing: .08em; text-transform: uppercase; color: #a9b0bc; }
	.pol-stats dd { margin: 6px 0 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(24px, 3.4vw, 38px); line-height: 1; font-variant-numeric: tabular-nums; }
	.pol-updated { margin: 14px 0 0; font-size: 12.5px; color: #7c8492; }
	@media (max-width: 720px) { .pol-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

	.pol-marquee { overflow: hidden; border-block: 1px solid var(--color-border); padding: 12px 0; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
	.pol-track { display: flex; gap: 14px; width: max-content; }
	.pol-tick { display: inline-flex; align-items: baseline; gap: 10px; padding: 8px 14px; border-radius: 999px; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); text-decoration: none; white-space: nowrap; font-size: 14px; }
	.pol-tick-t { max-width: 340px; overflow: hidden; text-overflow: ellipsis; color: var(--color-text-secondary); }
	.pol-tick b { font-family: var(--font-mono), monospace; }
	.pol-tick em, .pc-move { font-style: normal; font: 700 12px var(--font-mono), monospace; }
	.up { color: var(--bt-pos); } .down { color: #ef7b6f; }

	.pol-field { position: relative; width: 100%; border-radius: 20px; background: radial-gradient(ellipse at center, #141a24, #0d1118 70%); border: 1px solid #222a35; overflow: hidden; }
	.pol-bub { position: absolute; aspect-ratio: 1; transform: translate(-50%, -50%); text-decoration: none; color: #fff; }
