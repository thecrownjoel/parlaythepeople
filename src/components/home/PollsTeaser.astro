---
/**
 * Homepage: polls next to the markets. Left, races where the poll leader and the market favorite differ (or, when
 * they all agree, the closest races in the polls); right, the newest polls. Polls are the ones listed on Wikipedia's
 * race pages; the average is ours (lib/polls.ts).
 */
import { pollBoard, marginText, RCP_URL, type PollAverage } from "../../lib/polls";
import { consensus, pct, type Race } from "../../lib/markets";
import { raceName } from "../../lib/home";

interface Props { races: Race[] }
const { races } = Astro.props;
const board = await pollBoard();
const byId = new Map(races.map((r) => [r.id, r]));
const last = (n: string) => n.split(/\s+/).pop();
const day = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const side = (m: number) => (Math.abs(m) < 0.005 ? "" : m > 0 ? "D" : "R");

const rows = [...board.averages].flatMap(([id, a]) => {
	const r = byId.get(id);
	if (!r) return [];
	const c = consensus(r);
	const fav: "D" | "R" = c.D >= c.R ? "D" : "R";
	return [{ r, a, fav, favP: Math.max(c.D, c.R), pollLead: side(a.margin) }];
});
// a disagreement needs a real average: at least 2 polls, at least one not sponsored by a party or campaign
const solid = (a: PollAverage) => a.used >= 2 && a.independent >= 1;
const disagree = rows.filter((x) => x.pollLead && x.pollLead !== x.fav && solid(x.a)).sort((a, b) => b.favP - a.favP).slice(0, 6);
const closest = disagree.length ? [] : rows.filter((x) => x.r.kind !== "house" && solid(x.a)).sort((a, b) => Math.abs(a.a.margin) - Math.abs(b.a.margin)).slice(0, 6);
const list = disagree.length ? disagree : closest;
const latest = board.latest.filter((p) => byId.has(p.race_id)).slice(0, 7);
const favName = (x: { r: Race; a: PollAverage; fav: "D" | "R" }) => last(x.fav === "D" ? x.a.d_name : x.a.r_name);

// The chart: every Senate and governor race with a solid poll average, poll margin across, market odds up.
const W = 920, H = 300, L = 54, R = 16, T = 14, B = 40, SPAN = 0.25; // margin axis runs ±25 points
const X = (m: number) => L + ((Math.max(-SPAN, Math.min(SPAN, m)) + SPAN) / (2 * SPAN)) * (W - L - R);
const Y = (d: number) => T + (1 - d) * (H - T - B);
const plotted = rows.filter((x) => x.r.kind !== "house" && solid(x.a)).map((x) => {
	const c = consensus(x.r);
	return { ...x, d: c.D / (c.D + c.R || 1), off: !!x.pollLead && x.pollLead !== x.fav, vol: (x.r.k?.v ?? 0) + (x.r.p?.v ?? 0) };
});
const agree = plotted.filter((x) => !x.off).length;
const short = (r: Race) => `${r.st} ${r.kind === "senate" ? "Sen" : "Gov"}`;
// label the disagreements first, then the races with the most money, skipping any label that would collide
const placed: { x: number; y: number }[] = [];
const labelled = new Set<string>();
for (const x of [...plotted.filter((p) => p.off), ...[...plotted].sort((a, b) => b.vol - a.vol)]) {
	if (labelled.has(x.r.id) || labelled.size >= 6) continue;
	const px = X(x.a.margin), py = Y(x.d);
	if (placed.some((q) => Math.abs(q.x - px) < 64 && Math.abs(q.y - py) < 16)) continue;
	placed.push({ x: px, y: py });
	labelled.add(x.r.id);
}
---
{board.averages.size > 0 && (
	<section aria-labelledby="polls-home-h">
		<div class="sec-head">
			<h2 id="polls-home-h">Polls vs. the markets</h2>
			<p class="sec-note" style="margin:0">Our average of {board.total.toLocaleString("en-US")} public polls in {board.averages.size} races, next to the betting odds</p>
		</div>
		<div class="pl-rcp">
			<span>Built from the same public polls <strong>RealClearPolitics</strong> tracks, averaged our way and set against the money.</span>
			<span class="pl-rcp-links">Compare with RCP: <a href={RCP_URL.senate} rel="noopener nofollow" target="_blank">Senate polls ↗</a><a href={RCP_URL.governor} rel="noopener nofollow" target="_blank">Governor polls ↗</a><a href={RCP_URL.house} rel="noopener nofollow" target="_blank">House polls ↗</a></span>
		</div>
		{plotted.length >= 5 && (
			<figure class="panel pl-fig">
				<figcaption class="pl-cap"><strong>In {agree} of {plotted.length} Senate and governor races, the poll leader is also the market favorite.</strong> {plotted.length - agree === 1 ? "The other one sits in a shaded corner, where traders are betting against the polls." : plotted.length - agree > 1 ? "The rest sit in the shaded corners, where traders are betting against the polls." : "Traders aren't betting against the polls anywhere right now."}</figcaption>
				<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Poll margin against market odds for ${plotted.length} Senate and governor races; ${plotted.length - agree} disagree`}>
					<rect x={L} y={T} width={X(0) - L} height={Y(0.5) - T} class="pl-off" />
					<rect x={X(0)} y={Y(0.5)} width={W - R - X(0)} height={H - B - Y(0.5)} class="pl-off" />
					{[0, 0.25, 0.5, 0.75, 1].map((v) => <><line x1={L} x2={W - R} y1={Y(v)} y2={Y(v)} class={v === 0.5 ? "pl-mid" : "pl-grid"} /><text x={L - 8} y={Y(v) + 4} text-anchor="end" class="pl-tick">{Math.round(v * 100)}%</text></>)}
					{[-0.2, -0.1, 0, 0.1, 0.2].map((m) => <><line x1={X(m)} x2={X(m)} y1={T} y2={H - B} class={m === 0 ? "pl-mid" : "pl-grid"} /><text x={X(m)} y={H - B + 16} text-anchor="middle" class="pl-tick">{m === 0 ? "Tied" : `${m > 0 ? "D" : "R"}+${Math.abs(Math.round(m * 100))}`}</text></>)}
					<text x={(L + W - R) / 2} y={H - 4} text-anchor="middle" class="pl-axis">Poll average margin</text>
					<text x={16} y={(T + H - B) / 2} text-anchor="middle" class="pl-axis" transform={`rotate(-90 16 ${(T + H - B) / 2})`}>Market odds, Democrat</text>
					<text x={L + 8} y={T + 14} class="pl-corner">Markets: D · Polls: R</text>
					<text x={W - R - 8} y={H - B - 8} text-anchor="end" class="pl-corner">Polls: D · Markets: R</text>
					{plotted.map((x) => (
						<a href={x.r.path}>
							<circle cx={X(x.a.margin)} cy={Y(x.d)} r={x.off ? 6 : 4.5} class={`pl-dot pl-dot-${x.fav}${x.off ? " pl-dot-off" : ""}`}><title>{`${raceName(x.r)}: polls ${marginText(x.a)}, markets ${favName(x)} ${pct(x.favP)}`}</title></circle>
							{labelled.has(x.r.id) && <text x={X(x.a.margin) + 8} y={Y(x.d) + 4} class="pl-lab">{short(x.r)}</text>}
						</a>
					))}
				</svg>
			</figure>
		)}
		<div class="grid2">
			<div class="panel">
				<h3>{disagree.length ? "Where polls and markets disagree" : "Closest in the polls"}</h3>
				<p class="sec-note" style="margin:0 0 8px">{disagree.length ? "The poll leader isn't the candidate traders favor." : "Every poll leader is also the market favorite. The tightest races:"}</p>
				<ul class="pl-list">
					{list.map((x) => (
						<li>
							<a href={x.r.path}>{raceName(x.r)}</a>
							<span class="pl-pair">
								<span class={`num pl-${x.pollLead || "tie"}`}>Polls {marginText(x.a)}</span>
								<span class={`num pl-${x.fav}`}>Markets {favName(x)} {pct(x.favP)}</span>
							</span>
						</li>
					))}
				</ul>
			</div>
			<div class="panel">
				<h3>Latest polls</h3>
				<ul class="pl-list">
					{latest.map((p) => (
						<li>
							<a href={byId.get(p.race_id)!.path}>{raceName(byId.get(p.race_id)!)}</a>
							<span class="pl-pair">
								<span class="pl-who">{p.pollster} · {day(p.end_date)}</span>
								<span class={`num pl-${side(p.d - p.r) || "tie"}`}>{marginText({ margin: p.d - p.r, d_name: p.d_name, r_name: p.r_name })}</span>
							</span>
						</li>
					))}
				</ul>
			</div>
		</div>
		<p class="sec-note" style="font-size:12.5px;margin-top:8px">Polls as listed on Wikipedia (CC BY-SA 4.0), each citing its pollster. A poll lead measures vote share; market odds are the chance of winning, so a 3-point lead can mean a 70% favorite. Every race page shows its polls.</p>
	</section>
)}

<style>
	.pl-rcp { display: flex; justify-content: space-between; align-items: center; gap: 8px 18px; flex-wrap: wrap; margin: 4px 0 14px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--color-border); background: var(--color-surface); font-size: 13.5px; color: var(--color-text-secondary); }
	.pl-rcp strong { color: var(--color-text); }
	.pl-rcp-links { display: inline-flex; gap: 12px; flex-wrap: wrap; align-items: baseline; }
	.pl-rcp-links a { color: var(--color-text); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--color-border); }
	.pl-rcp-links a:hover { border-color: var(--color-text); }
	.pl-fig { margin: 0 0 16px; display: flex; flex-direction: column; gap: 10px; }
	.pl-cap { font-size: 14.5px; color: var(--color-text-secondary); margin: 0; }
	.pl-cap strong { color: var(--color-text); }
	.pl-fig svg { width: 100%; height: auto; display: block; overflow: visible; }
	.pl-off { fill: rgb(163 38 42 / .08); }
	.pl-grid { stroke: var(--color-border); stroke-width: 1; }
	.pl-mid { stroke: var(--color-muted); stroke-width: 1; stroke-dasharray: 3 3; }
	.pl-tick { fill: var(--color-muted); font: 10.5px var(--font-mono), monospace; }
	.pl-axis { fill: var(--color-text-secondary); font: 600 11px var(--font-body), sans-serif; }
	.pl-corner { fill: #f08a7e; font: 600 10.5px var(--font-mono), monospace; letter-spacing: .04em; }
	.pl-dot { stroke: var(--color-surface); stroke-width: 1.5; }
	.pl-dot-D { fill: var(--bt-d); } .pl-dot-R { fill: var(--bt-r); }
	.pl-dot-off { stroke: #fff; stroke-width: 2; }
	.pl-lab { fill: var(--color-text); font: 600 10.5px var(--font-mono), monospace; paint-order: stroke; stroke: var(--color-surface); stroke-width: 4px; stroke-linejoin: round; }
	a:hover .pl-dot { stroke: var(--color-text); stroke-width: 2.5; }
	.pl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
	.pl-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--color-border-subtle); font-size: 14px; min-width: 0; }
	.pl-list a { color: var(--color-text); text-decoration: none; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
	.pl-list a:hover { text-decoration: underline; }
	.pl-pair { display: flex; gap: 12px; align-items: baseline; flex-shrink: 0; }
	.pl-who { color: var(--color-muted); font-size: 12.5px; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.pl-D { color: var(--bt-d); font-weight: 600; } .pl-R { color: var(--bt-r); font-weight: 600; } .pl-tie { color: var(--color-text-secondary); font-weight: 600; }
	@media (max-width: 520px) { .pl-list li { flex-direction: column; gap: 2px; } .pl-pair { flex-wrap: wrap; } .pl-who { max-width: none; } }
</style>
