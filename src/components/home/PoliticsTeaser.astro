---
/** Homepage: a taste of /politics/, the busiest market in each of six topics today. */
import { getPolitics, money, marketPath, TOPIC_COLOR } from "../../lib/politics";

const board = await getPolitics();
const pick = board ? board.topics.map((t) => board.events.filter((e) => e.topic === t.key).sort((a, b) => b.vol24 - a.vol24)[0]).filter(Boolean).sort((a, b) => b!.vol24 - a!.vol24).slice(0, 6) : [];
const name = new Map((board?.topics ?? []).map((t) => [t.key, t.name]));
const pct = (p: number) => (p >= 0.995 ? ">99%" : p < 0.005 ? "<1%" : `${Math.round(p * 100)}%`);
---
{pick.length >= 3 && board && (
	<section class="ptz" aria-labelledby="ptz-h">
		<div class="ptz-glow" aria-hidden="true"></div>
		<div class="sec-head">
			<div>
				<p class="eyebrow" style="color:#f08a7e">Beyond the ballot</p>
				<h2 id="ptz-h">Everything else politics is betting on</h2>
			</div>
			<a class="ptz-all" href="/politics/">All {board.totals.events} politics markets →</a>
		</div>
		<p class="sec-note" style="margin:0 0 14px">{money(board.totals.vol24)} traded today on cabinet picks, the courts, world leaders, mayors and more. The busiest market in each topic:</p>
		<div class="ptz-grid">
			{pick.map((e) => (
				<a class="ptz-c" href={marketPath(e!)} style={`--tc:${TOPIC_COLOR[e!.topic] ?? "#9aa1ad"}`}>
					<span class="ptz-topic"><i></i>{name.get(e!.topic)}</span>
					<span class="ptz-t">{e!.title}</span>
					{e!.multi ? (
						<span class="ptz-bars">{e!.o.slice(0, 3).map((o) => <span class="ptz-row"><span>{o.n}</span><span class="ptz-bar"><i style={`--w:${Math.max(1, o.p * 100)}%`}></i></span><b>{pct(o.p)}</b></span>)}</span>
					) : (
						<span class="ptz-yes"><b>{pct(e!.o[0].p)}</b> chance of Yes<span class="ptz-bar"><i style={`--w:${Math.max(1, e!.o[0].p * 100)}%`}></i></span></span>
					)}
					<span class="ptz-vol">{money(e!.vol24)} today · {e!.src === "k" ? "Kalshi" : "Polymarket"}</span>
				</a>
			))}
		</div>
	</section>
)}

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);
	const root = document.querySelector<HTMLElement>(".ptz");
	if (root) {
		const fill = () => root.classList.add("in");
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) fill();
		else {
			gsap.from(root.querySelectorAll(".ptz-c"), {
				y: 50, opacity: 0, rotateX: -18, duration: 0.8, stagger: 0.09, ease: "power3.out", clearProps: "transform,opacity",
				scrollTrigger: { trigger: root, start: "top 78%", onEnter: fill },
			});
			gsap.to(root.querySelector(".ptz-glow"), { xPercent: 30, yPercent: 20, duration: 7, repeat: -1, yoyo: true, ease: "sine.inOut" });
		}
	}
</script>

<style>
	.ptz { position: relative; isolation: isolate; padding: clamp(18px, 3vw, 30px); border-radius: 20px; background: #0d1118; border: 1px solid #222a35; overflow: hidden; }
	.ptz-glow { position: absolute; z-index: -1; width: 60%; height: 120%; left: -10%; top: -40%; background: radial-gradient(closest-side, rgb(163 38 42 / .28), transparent); filter: blur(20px); }
	.ptz h2 { margin: 2px 0 0; }
	.ptz-all { font-weight: 700; color: var(--color-text); text-decoration: none; border-bottom: 1px solid #a3262a; white-space: nowrap; }
	.ptz-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; perspective: 900px; }
	.ptz-c { display: flex; flex-direction: column; gap: 9px; padding: 14px 16px; border-radius: 14px; text-decoration: none; color: var(--color-text);
		background: linear-gradient(160deg, color-mix(in srgb, var(--tc) 10%, #161c25), #161c25 60%); border: 1px solid #222a35; transition: border-color .2s, transform .2s; }
	.ptz-c:hover { border-color: var(--tc); transform: translateY(-3px); }
	.ptz-topic { display: inline-flex; align-items: center; gap: 7px; font: 700 11px var(--font-mono), monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--tc); }
	.ptz-topic i { width: 8px; height: 8px; border-radius: 50%; background: var(--tc); box-shadow: 0 0 10px var(--tc); }
	.ptz-t { font-weight: 700; font-size: 15px; line-height: 1.3; }
	.ptz-bars { display: grid; gap: 6px; }
	.ptz-row { display: grid; grid-template-columns: minmax(0, 1fr) 64px 40px; gap: 8px; align-items: center; font-size: 13px; }
	.ptz-row > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #c9cfd8; }
	.ptz-row b { text-align: right; font-family: var(--font-mono), monospace; font-size: 12.5px; }
	.ptz-bar { display: block; height: 7px; border-radius: 4px; background: rgb(255 255 255 / .07); overflow: hidden; }
	.ptz-bar i { display: block; height: 100%; width: 0; border-radius: 4px; background: var(--tc); transition: width 1.2s cubic-bezier(.2, .8, .2, 1) .3s; }
	.ptz.in .ptz-bar i { width: var(--w); }
	.ptz-yes { display: grid; gap: 7px; font-size: 13px; color: #a9b0bc; }
	.ptz-yes b { font: 800 26px var(--font-display); color: var(--color-text); margin-right: 6px; }
	.ptz-vol { margin-top: auto; font-size: 12px; color: #7c8492; }
</style>
