---
/** A standalone card for other sites to embed (no site chrome): title, the odds, a 24-hour line and a link back. */
interface Row { name: string; p: number; color: string }
interface Props { title: string; rows: Row[]; spark?: { ts: number; v: number }[]; href: string; note: string; theme: "light" | "dark" | "auto" }
const { title, rows, spark = [], href, note, theme } = Astro.props;
const W = 300, H = 40;
let d = "";
if (spark.length > 1) {
	const vs = spark.map((p) => p.v);
	let lo = Math.min(...vs), hi = Math.max(...vs);
	if (hi - lo < 0.06) { const m = (hi + lo) / 2; lo = m - 0.03; hi = m + 0.03; }
	const t0 = spark[0].ts, t1 = spark[spark.length - 1].ts;
	d = spark.map((p, i) => `${i ? "L" : "M"}${(((p.ts - t0) / Math.max(1, t1 - t0)) * W).toFixed(1)},${(3 + (1 - (p.v - lo) / (hi - lo)) * (H - 6)).toFixed(1)}`).join("");
}
const home = `${new URL(href).origin}/?utm_source=embed&utm_medium=card`;
const pct = (p: number) => (p >= 0.995 ? ">99%" : p < 0.005 ? "<1%" : `${Math.round(p * 100)}%`);
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex" />
	<title>{title} | Parlay the People</title>
	<link rel="canonical" href={href} />
	<style>
		:root { --bg: #ffffff; --fg: #14171c; --mut: #5d6672; --line: #e3e6ea; --track: #eef0f3; }
		@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #12151a; --fg: #eef1f5; --mut: #9aa3ae; --line: #2a2f37; --track: #222730; } }
		:root[data-theme="dark"] { --bg: #12151a; --fg: #eef1f5; --mut: #9aa3ae; --line: #2a2f37; --track: #222730; }
		* { box-sizing: border-box; }
		html, body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
		.e { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; min-height: 100vh; display: flex; flex-direction: column; gap: 10px; }
		.top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
		h1 { font-size: 16px; margin: 0; line-height: 1.3; min-width: 0; }
		.brand { flex: none; margin-top: 2px; font-size: 11px; font-weight: 700; letter-spacing: .02em; color: var(--mut); text-decoration: none; white-space: nowrap; }
		.brand:hover { color: var(--fg); text-decoration: underline; }
		h1 a { color: inherit; text-decoration: none; }
		h1 a:hover { text-decoration: underline; }
		ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
		li { display: grid; grid-template-columns: minmax(0, 1fr) 46px; gap: 4px 10px; align-items: center; }
		li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		li b { text-align: right; font-variant-numeric: tabular-nums; }
		li i { grid-column: 1 / -1; height: 7px; border-radius: 4px; background: var(--track); overflow: hidden; }
		li i u { display: block; height: 100%; border-radius: 4px; }
		svg { width: 100%; height: 40px; display: block; }
		footer { margin-top: auto; display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--mut); }
		footer a { color: var(--fg); font-weight: 700; text-decoration: none; white-space: nowrap; }
	</style>
</head>
<body>
	<div class="e">
		<div class="top">
			<h1><a href={href} target="_blank" rel="noopener">{title}</a></h1>
			<a class="brand" href={home} target="_blank" rel="noopener">parlaythepeople.com</a>
		</div>
		<ol>{rows.map((r) => <li><span>{r.name}</span><b>{pct(r.p)}</b><i><u style={`width:${Math.max(1, r.p * 100)}%;background:${r.color}`}></u></i></li>)}</ol>
		{d && <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Last 24 hours"><path d={d} fill="none" stroke={rows[0]?.color ?? "#5e92ee"} stroke-width="2" vector-effect="non-scaling-stroke" /></svg>}
		<footer><span>{note}</span><a href={href} target="_blank" rel="noopener">Parlay the People ↗</a></footer>
	</div>
</body>
</html>
