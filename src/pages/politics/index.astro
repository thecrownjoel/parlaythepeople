---
/** Beyond the ballot: every other politics market on Kalshi and Polymarket, by topic (board: components/PoliticsBoard.astro). */
import Base from "../../layouts/Base.astro";
import Discussion from "../../components/Discussion.astro";
import JsonLd from "../../components/JsonLd.astro";
import PoliticsBoard from "../../components/PoliticsBoard.astro";
import { getPolitics, politicsLd } from "../../lib/politics";
import { SITE_NAME } from "../../lib/site";

Astro.response.headers.set("cache-control", "public, max-age=300");
const board = await getPolitics();
const origin = Astro.url.origin;
const title = "Politics betting odds: every Kalshi and Polymarket market";
const description = `${board?.totals.events ?? "Hundreds of"} politics markets beyond the races, live: the Supreme Court, the cabinet, Congress, Trump, world leaders, mayors and more, with odds and money traded on Kalshi and Polymarket.`;
const ld = board ? politicsLd(origin, "/politics/", title, description, board.events, board.generated, [["Politics", "/politics/"]]) : null;
---
<Base title={title} description={description} canonical={`${origin}/politics/`} modifiedTime={board?.generated}>
	{ld && <JsonLd slot="head" data={ld} />}
	<PoliticsBoard board={board} />
	<div class="dp" style="padding-top:0"><Discussion /></div>
</Base>
