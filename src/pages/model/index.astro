---
/** The Parlay estimate: what it is, how it was built and tested, and how it will be scored. */
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { organization, breadcrumbs, faq, graph, SITE_NAME } from "../../lib/site";
import { MODEL, parlayD } from "../../lib/model";
import { getIndex, getCycle, consensus, pct } from "../../lib/markets";
import { raceName } from "../../lib/home";
import "../../styles/data.css";

const origin = Astro.url.origin;
const examples = [0.6, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95].map((m) => ({ m, e: parlayD(m, 1 - m)! }));
const pctGain = (a: number, b: number) => `${(((a - b) / a) * 100).toFixed(0)}%`;
const cv = MODEL.cv;

// live: the races where the estimate moves furthest from the market
const index = await getIndex();
const next = index?.next ? await getCycle(index.next) : null;
const live = (next?.races ?? [])
	.filter((r) => r.kind !== "control")
	.map((r) => { const c = consensus(r); const m = c.D / (c.D + c.R || 1); const e = parlayD(c.D, c.R)!; return { r, m, e, lead: m >= 0.5 ? "D" : "R" }; })
	.filter((x) => Math.abs(x.m - 0.5) < 0.4)
	.sort((a, b) => Math.abs(b.e - b.m) - Math.abs(a.e - a.m))
	.slice(0, 10);

const faqs: [string, string][] = [
	["What is the Parlay estimate?", `${SITE_NAME}'s own probability for each race, built by adjusting the prediction-market odds with a model trained on how decided races actually turned out.`],
	["How is it different from the market odds?", "In decided races, clear favorites (priced at 80% or more) won more often than their prices implied. The model corrects for that. Competitive races, with the favorite under 70%, keep the market's odds."],
	["Is the Parlay estimate betting advice?", `No. It is election research. ${SITE_NAME} does not make buy or sell recommendations, and what readers do with the research is their own decision.`],
	["Does social media buzz predict winners?", "Not on its own, so far. On 2024's decided races, a candidate getting more of the online conversation than their share of the odds was not more likely to win. The Pulse shows it because it often explains why a market is moving, and we will keep testing it as data grows."],
	["How will we know if it works?", "Every estimate is saved hourly and scored after Election Day against what the markets said, with the Brier score and log loss. The results will be published here, win or lose."],
];
const ld = graph(organization(origin), breadcrumbs(origin, [["The Parlay estimate", "/model/"]]), faq(faqs));
---
<Base title="The Parlay estimate: how our election model works" description={`How ${SITE_NAME}'s election forecast adjusts Kalshi and Polymarket odds using ${MODEL.trained_on} decided races, how it was tested, and how it will be scored.`} canonical={`${origin}/model/`}>
	<JsonLd slot="head" data={ld} />
	<div class="dp model">
		<header class="dp-head">
			<p class="eyebrow">Our model</p>
			<h1>The Parlay estimate</h1>
			<p class="lede">Prediction markets are good forecasters with a known flaw: in lopsided races, their favorites win more often than their prices say. The Parlay estimate corrects for it, using {MODEL.trained_on} decided races from 2024 and 2025 on Kalshi and Polymarket, and leaves competitive races at the market's odds.</p>
		</header>

		<section>
			<h2>How it changes the odds</h2>
			<p class="sec-note">Races where the favorite is under 70% keep the market's odds; the adjustment phases in between 70% and 80% and applies fully above that. It never flips a favorite.</p>
			<table class="dtable">
				<thead><tr><th>Market says the favorite wins</th><th>Parlay estimate</th></tr></thead>
				<tbody>{examples.map(({ m, e }) => <tr><td class="num">{pct(m)}</td><td class="num"><b>{pct(e)}</b></td></tr>)}</tbody>
			</table>
		</section>

		<section>
			<h2>How it was tested</h2>
			<p>We collected every decided Senate, House, governor and presidential-state race we could find on both exchanges, with daily prices from up to 90 days before Election Day. Each race was scored by a version of the model that never saw it (five-way cross-validation, repeated), and compared with the raw market odds.</p>
			<table class="dtable">
				<thead><tr><th>On races the model never saw</th><th>Market odds</th><th>Parlay estimate</th></tr></thead>
				<tbody>
					<tr><td>Log loss (lower is better)</td><td class="num">{cv.market.logloss.toFixed(3)}</td><td class="num"><b>{cv.model.logloss.toFixed(3)}</b> ({pctGain(cv.market.logloss, cv.model.logloss)} better)</td></tr>
					<tr><td>Brier score (lower is better)</td><td class="num">{cv.market.brier.toFixed(4)}</td><td class="num"><b>{cv.model.brier.toFixed(4)}</b></td></tr>
				</tbody>
			</table>
			<p class="sec-note" style="margin-top:10px">In decided races where markets priced the favorite between 65% and 80%, favorites won about as often as priced, which is why competitive races are left alone. We also tested price momentum, disagreement between the exchanges, thin markets, distance from Election Day and LunarCrush social data (each favorite's share of the conversation against its share of the odds, and sentiment, on 43 races with full social history). None improved accuracy on held-out races, so none are in the model yet. They will be retested on 2026's results, with several times more races, along with trade flow from our trade archive.</p>
		</section>

		{live.length > 0 && (
			<section>
				<h2>Where the estimate and the markets differ most</h2>
				<p class="sec-note">{index?.next} races where the model's adjustment is largest. Every race page shows its Parlay estimate beside the market odds.</p>
				<table class="dtable">
					<thead><tr><th>Race</th><th>Market</th><th>Parlay estimate</th></tr></thead>
					<tbody>{live.map(({ r, m, e, lead }) => <tr><td><a href={r.path}>{raceName(r)}</a></td><td class="num">{lead} {pct(Math.max(m, 1 - m))}</td><td class="num"><b>{lead} {pct(Math.max(e, 1 - e))}</b></td></tr>)}</tbody>
				</table>
			</section>
		)}

		<section>
			<h2>Questions</h2>
			<dl class="defs">{faqs.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}</dl>
		</section>
	</div>
</Base>

<style>
	.model { max-width: 900px; }
	.dtable { width: 100%; border-collapse: collapse; font-size: 15px; }
	.dtable th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--color-muted); padding: 8px 10px; border-bottom: 2px solid var(--color-border); }
	.dtable td { padding: 10px; border-bottom: 1px solid var(--color-border); }
	.dtable a { color: inherit; }
	.defs dt { font-weight: 600; margin-top: 14px; }
	.defs dd { margin: 4px 0 0; color: var(--color-text-secondary); line-height: 1.55; }
</style>
