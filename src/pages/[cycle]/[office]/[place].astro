---
/**
 * One race: /2026/senate/maine/, /2026/house/ca-22/, /2026/governor/ohio/, /2026/senate/control/
 * Answer first, then the numbers from each exchange, history, FAQ and related races.
 */
import Base from "../../../layouts/Base.astro";
import JsonLd from "../../../components/JsonLd.astro";
import HistoryChart from "../../../components/HistoryChart.astro";
import {
	getCycle, getHistory, consensus, shares, candidate, answer, raceSearchTitle, officeTitle,
	pct, fmtVol, fmtDate, daysUntil, RATING_LABEL, SRC_NAME, type Race, type Source,
} from "../../../lib/markets";
import { organization, breadcrumbs, faq, dataset, graph, SITE_NAME } from "../../../lib/site";
import "../../../styles/data.css";
import Sparkline from "../../../components/Sparkline.astro";
import LunarCrushCredit from "../../../components/LunarCrushCredit.astro";
import { getSocial, pulseIndex, racePulse, compact } from "../../../lib/social";
import RaceActivity from "../../../components/RaceActivity.astro";
import RaceMoney from "../../../components/RaceMoney.astro";
import RaceFinance from "../../../components/RaceFinance.astro";
import EmbedCode from "../../../components/EmbedCode.astro";
import RaceNotes from "../../../components/RaceNotes.astro";
import { candidateLinks } from "../../../lib/candidates";
import FollowButton from "../../../components/FollowButton.astro";
import ReportButton from "../../../components/ReportButton.astro";
import { pollAverage, marginText, RCP_URL } from "../../../lib/polls";
import { ratingsFor, FORECASTERS, FORECASTER_KEYS, chipClass, marketScore, scoreWord } from "../../../lib/ratings";
import { moneySince, kalshiRecent } from "../../../lib/money";
import { getKalshiTrades } from "../../../lib/markets";
import { raceSpark } from "../../../lib/trends";
import { renderMulti, rangeOf } from "../../../lib/chart";
import "../../../styles/charts.css";

const { cycle, office, place } = Astro.params;
if (!/^\d{4}$/.test(cycle ?? "")) return Astro.rewrite("/404");
const data = await getCycle(Number(cycle));
const path = `/${cycle}/${office}/${place}/`;
const race = data?.races.find((r) => r.path === path);
if (!data || !race) return Astro.rewrite("/404");

const origin = Astro.url.origin;
const c = consensus(race);
const polls = race.kind === "control" ? null : await pollAverage(race.id);
const expert = race.kind === "control" ? {} : await ratingsFor(race.id);
const pollPct = (x: number | null) => (x == null ? "—" : `${Math.round(x * 100)}%`);
const pollDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
const est = race.kind !== "control" ? parlayD(c.D, c.R) : null;
const estView = est == null ? null : {
	text: `${est >= 0.5 ? "D" : "R"} ${pct(Math.max(est, 1 - est))}`,
	style: `font-weight:600;color:var(--bt-${est >= 0.5 ? "d" : "r"})`,
	market: pct(Math.max(c.D, c.R) / (c.D + c.R || 1)),
};
const [social, kTrades] = await Promise.all([getSocial(), getKalshiTrades()]);
// Kalshi trades for this race's contracts (collected every 10 minutes for the most active contracts)
const kalshiTickers = (race.k?.o ?? []).filter((o) => o.id).map((o) => ({ id: o.id!, n: o.n, pa: o.pa }));
// every contract's recent trades from the archive; the collector's snapshot (busiest contracts only) as a fallback
const kArchive = await kalshiRecent(kalshiTickers.map((t) => t.id));
const kalshiByTicker = kalshiTickers.map((t) => (kArchive[t.id]?.length ? kArchive[t.id] : kTrades?.trades?.[t.id] ?? []));
// market stats from the collector
const sum = (xs: (number | null | undefined)[]) => xs.reduce<number>((a, x) => a + (x ?? 0), 0);
const kStats = race.k ? { v24: sum(race.k.o.map((o: any) => o.m?.v24)), oi: sum(race.k.o.map((o: any) => o.m?.oi)) } : null;
const pLead = race.p ? ([...race.p.o].sort((a, b) => b.p - a.p)[0] as any) : null;
const pStats = race.p ? { v24: sum(race.p.o.map((o: any) => o.m?.v24)), liq: sum(race.p.o.map((o: any) => o.m?.liq)), w: pLead?.m?.w ?? null, mo: pLead?.m?.mo ?? null, leadName: pLead?.n } : null;
const rp = racePulse(race, pulseIndex(social));
// 30 days: the Democrat's share of the conversation vs. Democratic odds
let convoChart = "";
if (rp.d && rp.r) {
	const rByDay = new Map(rp.r.series.map(([t, v]) => [Math.floor(t / 86400), v]));
	const share = rp.d.series.map(([t, v]) => { const o = rByDay.get(Math.floor(t / 86400)); return o != null && v + o > 0 ? { ts: t, v: v / (v + o) } : null; }).filter(Boolean) as { ts: number; v: number }[];
	const odds = await raceSpark(race.id, 30, "D");
	convoChart = renderMulti([
		{ spec: { kind: "out", id: race.id, key: "convo", label: `${rp.dName?.split(" ").slice(-1)[0]}'s share of buzz`, color: "#f5b041" }, points: share },
		{ spec: { kind: "out", id: race.id, key: "odds", label: "Democratic odds", color: "#5e92ee", dash: true }, points: odds },
	], { range: rangeOf("1m"), title: "Conversation share vs. odds" });
}
const pulseSides = ([["D", rp.dName, rp.d], ["R", rp.rName, rp.r]] as const).filter(([, , p]) => p);
const socialPosts = [...(rp.d?.top ?? []), ...(rp.r?.top ?? [])]
	.filter((p, i, a) => a.findIndex((q) => q.u === p.u) === i)
	.sort((a, b) => b.i - a.i)
	.slice(0, 5);
const ago = (t: number | null) => {
	if (!t) return "";
	const h = Math.round((Date.now() / 1000 - t) / 3600);
	return h < 1 ? "just now" : h < 24 ? `${h}h ago` : `${Math.round(h / 24)}d ago`;
};
const history = await getHistory(race.id);
const candLink = await candidateLinks();
const ks = shares(race.k), ps = shares(race.p);
const dName = candidate(race, "D"), rName = candidate(race, "R"), iName = candidate(race, "I");
const lede = answer(race, data.meta.generated);
const title = raceSearchTitle(race);
const officeName = race.kind === "control" ? (race.label.startsWith("Senate") ? "Senate" : "House") : race.kind === "house" ? "House" : race.kind === "senate" ? "Senate" : "Governor";
const days = daysUntil(data.meta.election_day);

// change over the last 7 days, from recorded history
const weekAgo = Date.now() / 1000 - 7 * 86400;
const first = history.find((h) => h.ts >= weekAgo);
const lastH = history[history.length - 1];
const dChange = (f: "k_d" | "p_d") => (first && lastH && first[f] != null && lastH[f] != null ? lastH[f]! - first[f]! : null);
const moves = [dChange("k_d"), dChange("p_d")].filter((x) => x != null) as number[];
const move = moves.length ? moves.reduce((a, b) => a + b, 0) / moves.length : null;
const moveText = move == null || !first
	? `Parlay the People began recording this race's price history on ${fmtDate(history[0]?.ts ?? data.meta.generated, false)}, so a weekly change isn't available yet.`
	: Math.abs(move) < 0.005
		? `Democratic odds are essentially unchanged since ${fmtDate(first.ts, false)}.`
		: `Democratic odds have ${move > 0 ? "risen" : "fallen"} ${Math.abs(move * 100).toFixed(1)} points since ${fmtDate(first.ts, false)}.`;

const gap = ks && ps ? Math.abs(ks.D - ps.D) : null;
const week7 = (await moneySince(Math.floor(Date.now() / 1000) - 7 * 86400)).get(race.id)?.usd ?? 0;
const srcSentence = [race.k && `Kalshi: Democrats ${pct(ks!.D)}, Republicans ${pct(ks!.R)}`, race.p && `Polymarket: Democrats ${pct(ps!.D)}, Republicans ${pct(ps!.R)}`]
	.filter(Boolean).join(". ") + "." + (gap != null ? ` The two exchanges differ by ${(gap * 100).toFixed(1)} points.` : "");
const raceWord = race.kind === "control" ? `control of the ${officeName} in ${race.cycle}` : `the ${race.cycle} ${race.kind === "house" ? race.label + " House" : race.state + " " + (race.kind === "senate" ? "Senate" : "governor")} race`;
const faqs: [string, string][] = [
	[`Who is favored to win ${raceWord}?`, lede],
	["What do Kalshi and Polymarket say?", srcSentence],
	["How have the odds moved this week?", moveText],
	...(polls ? [[`What do the polls say in ${raceWord}?`, `Our average of ${polls.used} recent public ${polls.used === 1 ? "poll" : "polls"} (newest ended ${pollDate(polls.latest)}) has ${marginText(polls) === "Tied" ? "the race tied" : marginText(polls).replace(" +", " ahead by ") + " points"}: ${polls.d_name} ${pollPct(polls.d)}, ${polls.r_name} ${pollPct(polls.r)}. Prediction markets give ${c.D >= c.R ? candidate(race, "D") ?? "the Democrat" : candidate(race, "R") ?? "the Republican"} a ${pct(Math.max(c.D, c.R))} chance to win.`] as [string, string]] : []),
	...(est != null ? [[`What is the Parlay estimate for ${raceWord}?`, Math.abs(est - c.D / (c.D + c.R || 1)) < 0.005
		? `The Parlay estimate matches the market: ${est >= 0.5 ? "Democrats" : "Republicans"} ${pct(Math.max(est, 1 - est))}. Our model leaves competitive races, where the favorite is under 70%, at the market's odds.`
		: `The Parlay estimate gives ${est >= 0.5 ? "Democrats" : "Republicans"} ${pct(Math.max(est, 1 - est))}, against ${pct(Math.max(c.D, c.R) / (c.D + c.R || 1))} in the markets. Our model, trained on decided races, finds that clear favorites win more often than their prices imply.`] as [string, string]] : []),
	[`How much money has been traded on ${raceWord}?`, `${fmtVol((race.k?.v ?? 0) + (race.p?.v ?? 0))} has traded on Kalshi and Polymarket combined${week7 ? `, ${fmtVol(week7)} of it in the past 7 days` : ""}.`],
	[`When is the ${race.cycle} election?`, `Election Day is ${fmtDate(data.meta.election_day + "T12:00:00-05:00", false)}${days > 0 ? `, ${days} days from now` : ""}.`],
];

// related races: same state, then the closest races of the same office
const sameState = data.races.filter((r) => r.st === race.st && r.id !== race.id && r.kind !== "control");
const closest = data.races
	.filter((r) => r.kind === race.kind && r.id !== race.id && !sameState.includes(r))
	.map((r) => ({ r, lp: consensus(r).lp }))
	.sort((a, b) => a.lp - b.lp)
	.slice(0, 8)
	.map((x) => x.r);

const crumbs: [string, string][] = [
	["Elections", "/elections/"],
	[`${race.cycle}`, `/${race.cycle}/`],
	[race.kind === "control" ? `${officeName} control` : race.kind === "house" ? race.label : `${race.state} ${officeName}`, path],
];
const description = lede.length > 158 ? lede.slice(0, 155).replace(/\s\S*$/, "") + "…" : lede;
const ld = graph(
	organization(origin),
	{
		"@type": "WebPage", "@id": `${origin}${path}#page`, url: `${origin}${path}`, name: title, description: lede,
		dateModified: data.meta.generated, isPartOf: { "@type": "WebSite", name: SITE_NAME, url: `${origin}/` },
		about: { "@type": "Thing", name: `${race.cycle} ${officeTitle(race)}` },
	},
	breadcrumbs(origin, crumbs),
	faq(faqs),
	dataset(origin, {
		name: `${race.cycle} ${officeTitle(race)}: prediction market odds`,
		description: `Kalshi and Polymarket win probabilities for ${raceWord}, recorded every 10 minutes by ${SITE_NAME}.`,
		path, json: `/api/v1/history/${race.id}.json`, modified: data.meta.generated,
		keywords: [String(race.cycle), race.state, officeName, "election odds", "prediction markets", "Kalshi", "Polymarket"],
	}),
);

function rows(s: Source) {
	const tot = s.o.reduce((a, o) => a + o.p, 0) || 1;
	return s.o.filter((o) => o.p / tot >= 0.002 || s.o.length <= 4).slice(0, 12).map((o) => ({ ...o, share: o.p / tot }));
}
const partyName = (p: string | null) => (p === "D" ? "Democratic" : p === "R" ? "Republican" : p === "I" ? "Independent" : "Other");
const generic = (n: string) => /^(democrat|democrats|democratic party|republican|republicans|republican party|independent|other)$/i.test(n.trim());
import { parlayD } from "../../../lib/model";
---
<style>
	.act-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 10px; margin-bottom: 14px; }
	.act-stat { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 3px; }
	.act-stat > span:first-child { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
	.act-stat b { font-family: var(--font-display); font-size: 26px; line-height: 1.05; }
	.act-stat > span:last-child { font-size: 12px; color: var(--color-muted); }
	.themes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 14px; }
	.themes-lab { display: block; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 6px; }
	.chips { display: flex; flex-wrap: wrap; gap: 6px; }
	.theme { font-size: 13px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-surface); }
	.theme.D { border-color: color-mix(in oklab, var(--bt-d) 50%, var(--color-border)); }
	.theme.R { border-color: color-mix(in oklab, var(--bt-r) 50%, var(--color-border)); }
	.pulse-card { display: flex; flex-direction: column; gap: 10px; border-top: 3px solid var(--pc); }
	.pc-head { display: flex; align-items: center; gap: 8px; }
	.pc-head strong { font-size: 17px; }
	.pc-link { margin-left: auto; font-size: 12.5px; color: var(--color-text-secondary); }
	.pc-up { color: var(--bt-pos); } .pc-down { color: var(--bt-r); }
	.pc-foot { font-size: 11.5px; color: var(--color-muted); margin-top: -4px; }
	.sov { display: grid; grid-template-columns: 110px minmax(0, 1fr) 60px; gap: 8px 12px; align-items: center; }
	.sov-lab { font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-muted); font-weight: 600; }
	.sov .num { text-align: right; font-size: 13px; }
	.split2 { display: flex; height: 12px; border-radius: 6px; overflow: hidden; gap: 2px; background: var(--color-border); }
	.split2 i { display: block; height: 100%; }
	.split2 .d { background: var(--bt-d); } .split2 .r { background: var(--bt-r); }
	.posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
	.posts a { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 12px; align-items: start; padding: 12px 2px; border-bottom: 1px solid var(--color-border); text-decoration: none; color: inherit; }
	.posts a:hover { background: var(--bt-hover); }
	.posts img, .post-av { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; display: flex; align-items: center; justify-content: center; background: var(--bt-chip); font-weight: 700; }
	.post-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.post-by { font-size: 12.5px; color: var(--color-muted); }
	.post-text { font-size: 14px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
	.post-i { font-size: 12.5px; color: var(--color-text-secondary); }
	.quote-board { background: #11151c; color: #e8ebf0; border-radius: 12px; padding: 14px 16px; min-width: 0; box-shadow: inset 0 0 0 1px #222a35; }
	.qb-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 8px; font-family: var(--font-display); font-weight: 800; font-size: 15px; letter-spacing: .06em; text-transform: uppercase; }
	.qb-head a { font-family: var(--font-body); font-weight: 500; font-size: 12.5px; letter-spacing: 0; text-transform: none; color: #a9b0bc; }
	.qb { width: 100%; border-collapse: collapse; font-family: var(--font-mono), monospace; font-size: 13.5px; }
	.qb th { font-family: var(--font-body); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: #7c8492; font-weight: 600; padding: 6px 6px; text-align: left; border-bottom: 1px solid #222a35; }
	.qb td { padding: 9px 6px; border-bottom: 1px solid #1b222c; color: #c3c9d3; white-space: nowrap; }
	.qb tr:last-child td { border-bottom: 0; }
	.qb .r { text-align: right; }
	.qb .cand { font-family: var(--font-body); color: #fff; font-weight: 600; white-space: normal; }
	.qb-price { color: #fff !important; font-weight: 600; font-size: 16px; }
	.qb-up { color: #4cc38a !important; } .qb-down { color: #f07a6c !important; }
	.qb-foot { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: 8px; font-size: 12px; color: #7c8492; }
	@media (max-width: 520px) { .qb th:nth-child(5), .qb td:nth-child(5) { display: none; } .qb { font-size: 12.5px; } }
	.est-how { font-size: 11px; font-weight: 500; text-transform: none; letter-spacing: 0; margin-left: 4px; }
	.fc-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
	.fc-cell { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
	.fc-src { font: 600 12px var(--font-mono), monospace; color: var(--color-text-secondary); }
	.fc-cell small { color: var(--color-muted); font-size: 12px; }
	.rt { display: inline-block; font: 700 14px/1 var(--font-mono), monospace; padding: 6px 9px; border-radius: 6px; }
	.rt-d3 { background: #1d3f8c; color: #fff; } .rt-d2 { background: #2e62d0; color: #fff; } .rt-d1 { background: color-mix(in srgb, #6f9bf2 45%, transparent); }
	.rt-toss { background: color-mix(in srgb, #a77dc2 35%, transparent); }
	.rt-r1 { background: color-mix(in srgb, #f2867b 45%, transparent); } .rt-r2 { background: #d23f35; color: #fff; } .rt-r3 { background: #8c241c; color: #fff; }
</style>
<Base title={title} description={description} canonical={`${origin}${path}`} type="website" modifiedTime={data.meta.generated} image={`${origin}/og/race/${race.id}.png`}>
	<JsonLd slot="head" data={ld} />
	<div class="dp">
		<nav class="crumbs" aria-label="Breadcrumb">
			{crumbs.map(([n, p], i) => (<>{i > 0 && <span aria-hidden="true">/</span>}{i < crumbs.length - 1 ? <a href={p}>{n}</a> : <span aria-current="page">{n}</span>}</>))}
		</nav>

		<header class="dp-head">
			<p class="eyebrow">{race.cycle} {race.kind === "control" ? "U.S. " + officeName : race.kind === "house" ? `${race.state} · U.S. House` : officeName}{race.special ? " · special election" : ""}</p>
			<h1>{race.kind === "control" ? `Who will control the ${officeName} after ${race.cycle}?` : race.kind === "house" ? `${race.label} House race odds` : `${race.state} ${officeName.toLowerCase() === "governor" ? "governor" : "Senate"} race odds`}</h1>
			<p class="lede">{lede}</p>
			<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center"><FollowButton id={race.id} name={officeTitle(race)} D={c.D} />{race.kind !== "control" && <ReportButton id={race.id} />}</div>
			<p class="updated"><span style="color:var(--money);font-weight:600">{fmtVol((race.k?.v ?? 0) + (race.p?.v ?? 0))} traded</span> · updated <time datetime={data.meta.generated}>{fmtDate(data.meta.generated)}</time> · prices refresh every 10 minutes</p>
		</header>

		<section class="panel duel" aria-label="Current odds">
			<div class="duel-top">
				<div class="duel-side">
					<span class="duel-name"><span class="sw D"></span> <b>{dName ?? "Democrats"}</b>{dName && " (D)"}</span>
					<span class="duel-pct" style="color:var(--bt-d)">{pct(c.D)}</span>
				</div>
				{c.O > 0.05 && (
					<div class="duel-side" style="align-items:center;text-align:center">
						<span class="duel-name"><span class="sw O"></span> <b>{iName ?? "Other"}</b>{iName && " (I)"}</span>
						<span class="duel-pct">{pct(c.O)}</span>
					</div>
				)}
				<div class="duel-side r">
					<span class="duel-name"><b>{rName ?? "Republicans"}</b>{rName && " (R)"} <span class="sw R"></span></span>
					<span class="duel-pct" style="color:var(--bt-r)">{pct(c.R)}</span>
				</div>
			</div>
			<div class="bar mid" role="img" aria-label={`Democrats ${pct(c.D)}, Republicans ${pct(c.R)}`}>
				<i class="D" style={`width:${c.D * 100}%`}></i>{c.O > 0.005 && <i class="O" style={`width:${c.O * 100}%`}></i>}<i class="R" style={`width:${c.R * 100}%`}></i>
			</div>
			<dl class="facts">
				{estView && <div><dt>Parlay estimate <a href="/model/" class="est-how">how?</a></dt><dd class="num" style={estView.style}>{estView.text} <span style="color:var(--color-muted);font-weight:400">vs. market {estView.market}</span></dd></div>}
				<div><dt>Market rating</dt><dd><span class={`chip ${c.lead}`}>{RATING_LABEL[c.rating]}</span></dd></div>
				<div><dt>Kalshi (D / R)</dt><dd class="num">{ks ? `${pct(ks.D, 1)} / ${pct(ks.R, 1)}` : "Not listed"}</dd></div>
				<div><dt>Polymarket (D / R)</dt><dd class="num">{ps ? `${pct(ps.D, 1)} / ${pct(ps.R, 1)}` : "Not listed"}</dd></div>
				<div><dt>Total traded</dt><dd class="num" style="color:var(--money);font-weight:600">{fmtVol((race.k?.v ?? 0) + (race.p?.v ?? 0))}</dd></div>
				<div><dt>Gap between exchanges</dt><dd class="num">{gap != null ? `${(gap * 100).toFixed(1)} pts` : "—"}</dd></div>
				<div><dt>Election Day</dt><dd>{fmtDate(data.meta.election_day + "T12:00:00-05:00", false)}{days > 0 && ` (${days} days)`}</dd></div>
			</dl>
		</section>

		{race.kind !== "control" && (
			<section aria-labelledby="polls-h">
				<h2 id="polls-h">Polls</h2>
				{polls ? (
					<>
						<p class="sec-note">
							<strong>Parlay polling average: {marginText(polls)}</strong> ({polls.d_name} {pollPct(polls.d)}, {polls.r_name} {pollPct(polls.r)}) from {polls.used} {polls.used === 1 ? "poll" : "polls"}, newest ended {pollDate(polls.latest)}.
							Markets give {c.D >= c.R ? candidate(race, "D") ?? "the Democrat" : candidate(race, "R") ?? "the Republican"} a {pct(Math.max(c.D, c.R))} chance to win: a poll lead measures vote share, not odds of winning.
						</p>
						<div class="tbl-wrap"><table class="tbl">
							<thead><tr><th>Pollster</th><th>Fieldwork ended</th><th class="r">Sample</th><th class="r">{polls.d_name.split(/\s+/).pop()} (D)</th><th class="r">{polls.r_name.split(/\s+/).pop()} (R)</th><th class="r">Margin</th></tr></thead>
							<tbody>{polls.polls.slice(0, 10).map((p) => <tr><td>{p.pollster}</td><td>{pollDate(p.end_date)}</td><td class="r num">{p.sample ? `${p.sample.toLocaleString("en-US")}${p.pop ? ` ${p.pop}` : ""}` : "—"}</td><td class="r num">{pollPct(p.d)}</td><td class="r num">{pollPct(p.r)}</td><td class="r num">{marginText({ margin: p.d - p.r, d_name: polls.d_name, r_name: polls.r_name })}</td></tr>)}</tbody>
						</table></div>
						<p class="sec-note" style="font-size:12.5px">Polls as listed on <a href={polls.source} rel="noopener" target="_blank">Wikipedia</a> (CC BY-SA 4.0), each citing its pollster. Average: each pollster's latest poll from the past 30 days, weighted by recency and sample size, partisan polls counted half. (D)/(R) after a pollster marks a party-sponsored poll. Compare with <a href={RCP_URL[race.kind]} rel="noopener nofollow" target="_blank">RealClearPolitics</a>.</p>
					</>
				) : <p class="sec-note">No general-election polls of this race are listed yet. See <a href={RCP_URL[race.kind]} rel="noopener nofollow" target="_blank">RealClearPolitics</a> for its poll listings.</p>}
			</section>
		)}

		{FORECASTER_KEYS.some((f) => expert[f]) && (
			<section aria-labelledby="fc-h">
				<h2 id="fc-h">What the forecasters say</h2>
				<div class="fc-row">
					{FORECASTER_KEYS.map((f) => expert[f] && (
						<div class="panel fc-cell">
							<a class="fc-src" href={FORECASTERS[f].url} rel="noopener" target="_blank">{FORECASTERS[f].name}</a>
							<span class={`rt ${chipClass(expert[f]!.score)}`}>{expert[f]!.rating}</span>
							{expert[f]!.as_of && <small>{new Date(`${expert[f]!.as_of}T12:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</small>}
						</div>
					))}
					{(() => { const pD = c.D / Math.max(0.01, c.D + c.R); const m = marketScore(pD); return (
						<div class="panel fc-cell">
							<span class="fc-src">Kalshi + Polymarket</span>
							<span class={`rt ${chipClass(m)}`}>{scoreWord(m)}</span>
							<small>{pct(Math.max(pD, 1 - pD))} {pD >= 0.5 ? "D" : "R"} now</small>
						</div>
					); })()}
				</div>
				<p class="sec-note" style="font-size:12.5px">Ratings as cited on Wikipedia, with each forecaster's date. Markets on the same scale: 40–60% toss-up, 60–75% Lean, 75–90% Likely, 90%+ Safe. <a href="/forecasters/">Every race: the experts vs. the markets →</a></p>
			</section>
		)}

		<section aria-labelledby="quotes-h">
			<h2 id="quotes-h">Share prices</h2>
			<p class="sec-note">Each contract pays $1 if that outcome happens. The price is what traders are paying now, so 60¢ means roughly a 60% chance. Bid is the best offer to buy, ask the best offer to sell.</p>
			<div class="grid2">
				{(["k", "p"] as const).filter((x) => race[x]).map((x) => (
					<div class="quote-board">
						<div class="qb-head"><span>{SRC_NAME[x]}</span><a href={race[x]!.url} rel="nofollow noopener" target="_blank">Trade on {SRC_NAME[x]} ↗</a></div>
						<table class="qb">
							<thead><tr><th>Contract</th><th class="r">Price</th><th class="r">Bid</th><th class="r">Ask</th><th class="r">Last</th><th class="r">24h</th></tr></thead>
							<tbody>
								{race[x]!.o.filter((o) => o.p >= 0.005 || race[x]!.o.length <= 4).slice(0, 8).map((o) => {
									const [bid, ask, last] = o.q ?? [null, null, null];
									const c = (v: number | null | undefined) => (v == null ? "—" : `${Math.round(v * 100)}¢`);
									const d = o.d == null ? null : Math.round(o.d * 100);
									return (
										<tr>
											<td><span class="cand"><span class={`sw ${o.pa ?? "O"}`}></span>{generic(o.n) ? partyName(o.pa) : o.n}</span></td>
											<td class="r qb-price">{c(o.p)}</td>
											<td class="r">{c(bid)}</td>
											<td class="r">{c(ask)}</td>
											<td class="r">{c(last)}</td>
											<td class={`r ${d == null || d === 0 ? "" : d > 0 ? "qb-up" : "qb-down"}`}>{d == null ? "—" : d === 0 ? "0¢" : `${d > 0 ? "▲" : "▼"}${Math.abs(d)}¢`}</td>
										</tr>
									);
								})}
							</tbody>
						</table>
						<div class="qb-foot"><span>Volume {fmtVol(race[x]!.v ?? 0)}</span><span>As of {fmtDate(data.meta.generated)}</span></div>
					</div>
				))}
			</div>
		</section>

		<section aria-labelledby="activity-h">
			<h2 id="activity-h">Market activity</h2>
			<p class="sec-note">How much is trading, where the money is going, and the live order book.</p>
			<div class="act-stats">
				{kStats && <div class="act-stat"><span class="x-k">Kalshi</span><b class="num">{compact(kStats.v24)}</b><span>contracts traded (24h)</span></div>}
				{kStats && <div class="act-stat"><span class="x-k">Kalshi</span><b class="num">{compact(kStats.oi)}</b><span>contracts open</span></div>}
				{pStats && <div class="act-stat"><span class="x-p">Polymarket</span><b class="num">{fmtVol(pStats.v24)}</b><span>traded (24h)</span></div>}
				{pStats && <div class="act-stat"><span class="x-p">Polymarket</span><b class="num">{fmtVol(pStats.liq)}</b><span>in the order book</span></div>}
				{pStats?.w != null && <div class="act-stat"><span>1 week</span><b class={`num ${pStats.w >= 0 ? "pc-up" : "pc-down"}`}>{pStats.w >= 0 ? "▲" : "▼"} {Math.abs(Math.round(pStats.w * 100))}¢</b><span>{pStats.leadName}</span></div>}
				{pStats?.mo != null && <div class="act-stat"><span>1 month</span><b class={`num ${pStats.mo >= 0 ? "pc-up" : "pc-down"}`}>{pStats.mo >= 0 ? "▲" : "▼"} {Math.abs(Math.round(pStats.mo * 100))}¢</b><span>{pStats.leadName}</span></div>}
			</div>
			<RaceMoney raceId={race.id} />
			<RaceActivity race={race} kalshi={kalshiByTicker} kalshiTickers={kalshiTickers} />
		</section>

		<p class="sec-note"><a href={`/compare/?races=${race.id}`}>Compare this race with others →</a></p>

		<RaceNotes raceId={race.id} />

		<EmbedCode src={`${origin}/embed/race/${race.id}/`} height={race.kind === "control" ? 200 : 210} />

		{race.kind !== "control" && <RaceFinance race={race} names={[candidate(race, "D"), candidate(race, "R"), candidate(race, "I")].filter((n): n is string => !!n)} />}

		{pulseSides.length > 0 && (
			<section aria-labelledby="pulse-h">
				<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap">
					<h2 id="pulse-h">Social pulse</h2>
					<LunarCrushCredit />
				</div>
				<p class="sec-note">What social media is saying about the candidates, next to what the markets are betting.{rp.sovD != null && ` ${rp.dName} has ${Math.round(rp.sovD * 100)}% of the conversation and ${Math.round(rp.oddsD * 100)}% of the odds.`}</p>
				<div class="grid2">
					{pulseSides.map(([party, name, p]) => (
						<div class="panel pulse-card" style={`--pc:${party === "D" ? "var(--bt-d)" : "var(--bt-r)"}`}>
							<div class="pc-head"><span class={`sw ${party}`}></span><strong>{name}</strong><a href={p!.link} target="_blank" rel="noopener" class="pc-link">LunarCrush ↗</a></div>
							<dl class="facts">
								<div><dt>Interactions (24h)</dt><dd class="num">{compact(p!.i24)}</dd></div>
								<div><dt>People posting</dt><dd class="num">{p!.contributors.toLocaleString()}</dd></div>
								<div><dt>Sentiment</dt><dd class="num">{p!.sentiment != null ? `${Math.round(p!.sentiment)}% positive` : "—"}</dd></div>
								<div><dt>This week vs. last</dt><dd class={`num ${(p!.wow ?? 0) >= 0 ? "pc-up" : "pc-down"}`}>{p!.wow != null ? `${p!.wow >= 0 ? "▲" : "▼"} ${Math.abs(Math.round(p!.wow * 100))}%` : "—"}</dd></div>
							</dl>
							<Sparkline points={p!.series.map(([t, v]) => ({ ts: t, v }))} color={party === "D" ? "var(--bt-d)" : "var(--bt-r)"} label={`${name}: social interactions, last 30 days`} />
							<span class="pc-foot">Social interactions, last 30 days</span>
						</div>
					))}
				</div>
				{rp.sovD != null && (
					<div class="panel" style="margin-top:14px">
						<div class="sov">
							<span class="sov-lab">Conversation</span>
							<span class="split2"><i class="d" style={`width:${rp.sovD * 100}%`}></i><i class="r" style={`width:${(1 - rp.sovD) * 100}%`}></i></span>
							<span class="num">{Math.round(rp.sovD * 100)} / {Math.round((1 - rp.sovD) * 100)}</span>
							<span class="sov-lab">Market odds</span>
							<span class="split2"><i class="d" style={`width:${rp.oddsD * 100}%`}></i><i class="r" style={`width:${(1 - rp.oddsD) * 100}%`}></i></span>
							<span class="num">{Math.round(rp.oddsD * 100)} / {Math.round((1 - rp.oddsD) * 100)}</span>
						</div>
					</div>
				)}
				{convoChart && (
					<div class="panel" style="margin-top:14px">
						<h3>Conversation share vs. odds · last 30 days</h3>
						<div class="hc-body" set:html={convoChart} />
					</div>
				)}
				{pulseSides.some(([, , p]) => (p as any)?.rel?.length) && (
					<div class="themes" style="margin-top:14px">
						{pulseSides.map(([party, name, p]) => (p as any)?.rel?.length > 0 && (
							<div><span class="themes-lab">What people connect with {name?.split(" ").slice(-1)[0]}</span>
								<div class="chips">{(p as any).rel.slice(0, 10).map((t: string) => <span class={`theme ${party}`}>{t}</span>)}</div></div>
						))}
					</div>
				)}
				{socialPosts.length > 0 && (
					<div style="margin-top:14px">
						<h3>Top posts right now</h3>
						<ul class="posts">
							{socialPosts.map((p) => (
								<li>
									<a href={p.u} target="_blank" rel="noopener nofollow">
										{p.av ? <img src={p.av} alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" /> : <span class="post-av" aria-hidden="true">{(p.by ?? "?").slice(0, 1)}</span>}
										<span class="post-body">
											<span class="post-by">{p.by ?? "Unknown"}{p.f ? ` · ${compact(p.f)} followers` : ""}{p.net ? ` · ${p.net}` : ""}{p.at ? ` · ${ago(p.at)}` : ""}</span>
											<span class="post-text">{p.t}</span>
										</span>
										<span class="num post-i">{compact(p.i)}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		)}

		<section>
			<h2>Price history</h2>
			<div class="panel"><HistoryChart raceId={race.id} data={data} label="Democratic odds" /></div>
		</section>

		<section>
			<h2>Every candidate, by exchange</h2>
			<p class="sec-note">Each exchange's prices rescaled to add up to 100%. Kalshi prices are the bid–ask midpoint; Polymarket prices are its displayed price.</p>
			<div class="grid2">
				{(["k", "p"] as const).map((x) => {
					const s = race[x];
					return (
						<div class="panel">
							<h3>{SRC_NAME[x]} {s && <a href={s.url} rel="nofollow noopener" target="_blank" style="font-weight:400;font-size:13px;color:var(--color-text-secondary)">open market ↗</a>}</h3>
							{s ? (
								<table class="tbl" style="border:0">
									<thead><tr><th>Outcome</th><th class="r">Chance</th><th class="r">Volume</th></tr></thead>
									<tbody>
										{rows(s).map((o) => (
											<tr>
												<td><span class="cand"><span class={`sw ${o.pa ?? "O"}`}></span>{generic(o.n) ? partyName(o.pa) + " candidate" : candLink(o.n, race.st) ? <a href={candLink(o.n, race.st)!}>{o.n}</a> : o.n}{o.pa && !generic(o.n) && <span style="color:var(--color-muted)"> ({o.pa})</span>}</span></td>
												<td class="r num">{pct(o.share, 1)}</td>
												<td class="r num">{fmtVol(o.v)}</td>
											</tr>
										))}
									</tbody>
								</table>
							) : <p class="sec-note" style="margin:0">{SRC_NAME[x]} doesn't list this race.</p>}
						</div>
					);
				})}
			</div>
		</section>

		<section>
			<h2>Questions about this race</h2>
			<div class="faq">
				{faqs.map(([q, a], i) => (<details open={i < 2}><summary>{q}</summary><p>{a}</p></details>))}
			</div>
		</section>

		{sameState.length > 0 && (
			<section>
				<h2>Other {race.state} races in {race.cycle}</h2>
				<ul class="racelist">
					{sameState.map((r) => { const cc = consensus(r); return (
						<li><a href={r.path}>{r.kind === "house" ? r.label + " House" : `${r.state} ${r.kind === "senate" ? "Senate" : "Governor"}`}</a><span class={`num ${cc.lead === "D" ? "dlead" : "rlead"}`}>{cc.lead} {pct(cc.lp)} · {fmtVol((r.k?.v ?? 0) + (r.p?.v ?? 0))}</span></li>
					); })}
				</ul>
			</section>
		)}

		{closest.length > 0 && (
			<section>
				<h2>Closest {race.kind === "house" ? "House" : race.kind === "senate" ? "Senate" : race.kind === "governor" ? "governor" : ""} races in {race.cycle}</h2>
				<ul class="racelist">
					{closest.map((r) => { const cc = consensus(r); return (
						<li><a href={r.path}>{r.kind === "house" ? r.label : r.kind === "control" ? r.label : r.state}</a><span class={`num ${cc.lead === "D" ? "dlead" : "rlead"}`}>{cc.lead} {pct(cc.lp)} · {fmtVol((r.k?.v ?? 0) + (r.p?.v ?? 0))}</span></li>
					); })}
				</ul>
			</section>
		)}

		<section>
			<h2>Data</h2>
			<p class="datalinks">
				<a href={`/api/v1/history/${race.id}.json`}>Price history (JSON)</a>
				<a href={`/api/v1/${race.cycle}.json`}>All {race.cycle} races (JSON)</a>
				<a href={`/api/v1/${race.cycle}/races.csv`}>All {race.cycle} races (CSV)</a>
				<a href={`/${race.cycle}/`}>{race.cycle} dashboard</a>
				<a href="/methodology/">Methodology</a>
			</p>
			<p class="disclaimer">Cite as: {SITE_NAME}, “{race.cycle} {officeTitle(race)},” {origin}{path}, accessed {fmtDate(data.meta.generated, false)}. Prediction-market prices are crowd forecasts, not certainties, and nothing here is betting or investment advice.</p>
		</section>
	</div>
</Base>
