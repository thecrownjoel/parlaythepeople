---
/**
 * Home: the next election at a glance, with live trends, the money map, movers, the presidency,
 * and the Analysis desk (which carries the site between elections).
 */
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import Sparkline from "../components/Sparkline.astro";
import StateTileMap from "../components/StateTileMap.astro";
import MoneyGlobe from "../components/MoneyGlobe.astro";
import { getNews, getIndex, getCycle, consensus, shares, pct, fmtVol, fmtDate, daysUntil, PARTY_PLURAL, type Race, type PresMarket, type Source } from "../lib/markets";
import { raceSpark, outcomeSpark, movers, historyCounts, stateRaces, leadChanges, candidateMoves, type Spark } from "../lib/trends";
import { nameKey } from "../lib/names";
import { mediaUrls } from "../lib/media";
import { organization, graph, SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import "../styles/data.css";

const origin = Astro.url.origin;
const index = await getIndex();
const nextYear = index?.next;
const presYear = index?.cycles.find((c) => c.offices.includes("president") && c.year >= (nextYear ?? 0))?.year;
const [next, presCycle, posts, counts, news] = await Promise.all([
	nextYear ? getCycle(nextYear) : Promise.resolve(null),
	presYear ? getCycle(presYear) : Promise.resolve(null),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 13 }),
	historyCounts(),
	getNews(),
]);
if (Astro.cache?.enabled) Astro.cache.set(posts.cacheHint);

const races = next?.races ?? [];
const byId = (id: string) => races.find((r) => r.id === id);
const senC = nextYear ? byId(`${nextYear}-senate-control`) : undefined;
const houseC = nextYear ? byId(`${nextYear}-house-control`) : undefined;
const avgShares = (m?: PresMarket) => {
	const arr = (["k", "p"] as const).map((x) => m?.[x]).filter(Boolean).map((s) => shares(s as Source)!);
	return arr.length ? { D: arr.reduce((a, s) => a + s.D, 0) / arr.length, R: arr.reduce((a, s) => a + s.R, 0) / arr.length } : null;
};
const presParty = avgShares(presCycle?.pres.party);
const days = next ? daysUntil(next.meta.election_day) : null;
const when = next ? fmtDate(next.meta.generated, false) : "";

// ---- lede
const favored: { party: "D" | "R"; what: string; p: number }[] = [];
if (senC) favored.push({ party: consensus(senC).lead as "D" | "R", what: "the Senate", p: consensus(senC).lp });
if (houseC) favored.push({ party: consensus(houseC).lead as "D" | "R", what: "the House", p: consensus(houseC).lp });
if (presParty) favored.push({ party: presParty.D >= presParty.R ? "D" : "R", what: `the ${presYear} presidency`, p: Math.max(presParty.D, presParty.R) });
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);
const summary = (["D", "R"] as const)
	.map((pa) => favored.filter((f) => f.party === pa))
	.filter((fs) => fs.length)
	.map((fs) => `${PARTY_PLURAL[fs[0].party]} are favored to win ${list(fs.map((f) => `${f.what} (${pct(f.p)})`))}`);
const lede = summary.length
	? `As of ${when}, prediction markets say ${summary.join("; ")}. ${SITE_NAME} tracks every race on Kalshi and Polymarket, side by side, keeps the price history, and covers the politics behind the numbers.`
	: SITE_DESCRIPTION;

// ---- stats band
const totalRaces = (index?.cycles ?? []).reduce((a, c) => a + c.races, 0);
const traded = races.reduce((a, r) => a + (r.k?.v ?? 0) + (r.p?.v ?? 0), 0);

// ---- trend cards (90-day lines; change over 30 days)
type Card = { label: string; sub: string; now: number | null; color: string; spark: Spark[]; href: string };
const sparkChange = (s: Spark[]) => {
	if (s.length < 2) return null;
	const cut = s[s.length - 1].ts - 30 * 86400;
	const base = [...s].reverse().find((p) => p.ts <= cut) ?? s[0];
	return s[s.length - 1].v - base.v;
};
const bopNow = next?.big?.bop ? (["k", "p"] as const).map((x) => next.big.bop[x]?.o?.DD).filter((v) => v != null) : [];
const [sSen, sHouse, sPres, sSweep, sPv] = await Promise.all([
	senC ? raceSpark(senC.id) : Promise.resolve([]),
	houseC ? raceSpark(houseC.id) : Promise.resolve([]),
	presYear ? raceSpark(`${presYear}-president`) : Promise.resolve([]),
	nextYear ? outcomeSpark(`${nextYear}-bop`, "DD") : Promise.resolve([]),
	nextYear ? outcomeSpark(`${nextYear}-majority`, "popvote-D") : Promise.resolve([]),
]);
const cards: Card[] = [
	senC && { label: "Democrats win the Senate", sub: `${nextYear}`, now: consensus(senC).D, color: "var(--bt-d)", spark: sSen, href: senC.path },
	houseC && { label: "Democrats win the House", sub: `${nextYear}`, now: consensus(houseC).D, color: "var(--bt-d)", spark: sHouse, href: houseC.path },
	presParty && { label: "Democrats win the presidency", sub: `${presYear}`, now: presParty.D, color: "var(--bt-d)", spark: sPres, href: `/${presYear}/president/` },
	bopNow.length && { label: "Democrats sweep Congress", sub: `${nextYear} balance of power`, now: (bopNow as number[]).reduce((a, b) => a + b, 0) / bopNow.length, color: "var(--bt-d)", spark: sSweep, href: `/${nextYear}/` },
	sPv.length && { label: "Democrats win the House vote", sub: `${nextYear} national popular vote`, now: sPv[sPv.length - 1].v, color: "var(--bt-d)", spark: sPv, href: `/${nextYear}/` },
].filter(Boolean) as Card[];

// ---- map & globe
const senMap = next ? stateRaces(next, "senate") : [];
const govMap = next ? stateRaces(next, "governor") : [];
const houseMap = next ? stateRaces(next, "house") : [];
const globeRaces = [
	...senMap.map((r) => ({ ...r, office: "Senate", key: r.path })),
	...govMap.map((r) => ({ ...r, office: "Governor", key: r.path })),
	...houseMap.map((r) => ({ ...r, office: "House", key: r.path })),
];
const topMoney = [...globeRaces].sort((a, b) => b.vol - a.vol).slice(0, 5);

// ---- lists
const name = (r: Race) => (r.kind === "house" ? `${r.label} (${r.state})` : `${r.state} ${r.kind === "senate" ? "Senate" : "Governor"}`);
const closest = races.filter((r) => r.kind !== "control").map((r) => ({ r, c: consensus(r) })).sort((a, b) => a.c.lp - b.c.lp).slice(0, 8);
const gaps = races.filter((r) => r.k && r.p).map((r) => ({ r, g: Math.abs(shares(r.k)!.D - shares(r.p)!.D) })).sort((a, b) => b.g - a.g).slice(0, 6);
const moved = next ? await movers(next, 7, 6) : [];

// ---- presidency leaderboard
function merged(m?: PresMarket, limit = 6) {
	if (!m) return [];
	const rows = new Map<string, { key: string; n: string; pa: string | null; vals: number[] }>();
	for (const x of ["k", "p"] as const) {
		const s = m[x];
		if (!s) continue;
		const tot = s.o.reduce((a, o) => a + o.p, 0) || 1;
		for (const o of s.o) {
			const key = nameKey(o.n);
			const row = rows.get(key) ?? { key, n: o.n, pa: o.pa, vals: [] };
			row.vals.push(o.p / tot);
			row.pa = row.pa ?? o.pa;
			rows.set(key, row);
		}
	}
	return [...rows.values()].map((r) => ({ ...r, v: r.vals.reduce((a, b) => a + b, 0) / r.vals.length })).sort((a, b) => b.v - a.v).slice(0, limit);
}
const leaders = merged(presCycle?.pres.winner, 6);
const leaderSparks = await Promise.all(leaders.map((l) => outcomeSpark(`${presYear}-pres-winner`, l.key)));
const nomD = merged(presCycle?.pres.nomD, 3), nomR = merged(presCycle?.pres.nomR, 3);

// ---- ballot measures closest to a coin flip (skip thin markets)
const coinFlips = (next?.big?.ballots ?? []).filter((b: any) => !b.thin).sort((a: any, b: any) => Math.abs(a.p - 0.5) - Math.abs(b.p - 0.5)).slice(0, 6);

// ---- analysis
// Analysis lineup: one row per post with the author's photo
const avatarById = await mediaUrls(posts.entries.slice(0, 10).map((p) => p.data.bylines?.[0]?.byline?.avatarMediaId));
const lineup = posts.entries.slice(0, 10).map((p) => {
	const by = p.data.bylines?.[0]?.byline;
	return {
		href: `/posts/${p.id}`, title: p.data.title, date: p.data.publishedAt as Date | null | undefined,
		author: by?.displayName ?? SITE_NAME,
		avatar: (by?.avatarMediaId && avatarById.get(by.avatarMediaId)) || null,
		initials: (by?.displayName ?? SITE_NAME).split(/\s+/).map((w: string) => w[0]).slice(0, 2).join("").toUpperCase(),
	};
});
// Ticker: newest analysis headlines first, then live market headlines.
const ticker: { text: string; href: string; tag: string; external?: boolean }[] = [
	...(news?.items ?? []).slice(0, 16).map((n) => ({ text: n.title, href: n.url, tag: n.source || n.tag, external: true })),
	...posts.entries.slice(0, 2).map((p) => ({ text: p.data.title, href: `/posts/${p.id}`, tag: SITE_NAME })),
	...(senC ? [{ text: `${PARTY_PLURAL[consensus(senC).lead as "D" | "R"]} ${pct(consensus(senC).lp)} to win the Senate`, href: senC.path, tag: "Markets" }] : []),
	...(houseC ? [{ text: `${PARTY_PLURAL[consensus(houseC).lead as "D" | "R"]} ${pct(consensus(houseC).lp)} to win the House`, href: houseC.path, tag: "Markets" }] : []),
	...(presParty ? [{ text: `${presYear} presidency: Democrats ${pct(presParty.D)}, Republicans ${pct(presParty.R)}`, href: `/${presYear}/president/`, tag: "Markets" }] : []),
	...moved.slice(0, 3).map((m) => ({ text: `${name(m.race)}: Democratic odds ${m.delta >= 0 ? "up" : "down"} ${Math.abs(m.delta * 100).toFixed(1)} pts this week`, href: m.race.path, tag: "Movers" })),
	...closest.slice(0, 2).map(({ r, c }) => ({ text: `Toss-up watch: ${name(r)} at ${c.lead} ${pct(c.lp)}`, href: r.path, tag: "Close race" })),
];
// ---- midterms snapshot: control gauges, median seat counts, headline tiles
const medianBin = (g: any) => {
	const src = g?.k ?? g?.p; if (!src) return null;
	let c = 0;
	for (const b of src.bins) { c += b.p; if (c >= 0.5) return b.l as string; }
	return null;
};
const senMedian = medianBin(next?.big?.senate), houseMedian = medianBin(next?.big?.house);
const tossups = races.filter((r) => r.kind !== "control" && consensus(r).rating === "T").length;
const sweepNow = cards.find((c) => c.label.startsWith("Democrats sweep"))?.now ?? null;
const pvNow = cards.find((c) => c.label.startsWith("Democrats win the House vote"))?.now ?? null;

// ---- storylines: lead changes and candidate moves
const flips = next ? await leadChanges(next, 6) : [];
const presRows = presCycle ? [
	{ group: `${presYear}-pres-winner`, market: "presidency", items: merged(presCycle.pres.winner, 25) },
	{ group: `${presYear}-pres-nomD`, market: "Democratic nomination", items: merged(presCycle.pres.nomD, 25) },
	{ group: `${presYear}-pres-nomR`, market: "Republican nomination", items: merged(presCycle.pres.nomR, 25) },
] : [];
const cmoves = presYear ? await candidateMoves(presYear, presRows, 30) : { rising: [], fading: [] };

const h1Words = "Political News, Election odds from Kalshi and Polymarket, race by race".split(" ");
const postDate = (d?: Date | null) => (d ? d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "");

const ld = graph(organization(origin), {
	"@type": "WebSite", "@id": `${origin}/#site`, url: `${origin}/`, name: SITE_NAME, description: SITE_DESCRIPTION, publisher: { "@id": `${origin}/#org` },
	potentialAction: { "@type": "SearchAction", target: `${origin}/search?q={query}`, "query-input": "required name=query" },
});
const partyColor = (pa: string | null) => (pa === "D" ? "var(--bt-d)" : pa === "R" ? "var(--bt-r)" : "var(--bt-oth)");
---
<style>
	.home-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: center; }
	.home-hero-text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
	.home-hero-logo { width: clamp(220px, 24vw, 300px); height: auto; display: block; filter: drop-shadow(0 12px 28px rgb(163 38 42 / 0.25)); }
	@media (max-width: 760px) { .home-hero { grid-template-columns: 1fr; } .home-hero-logo { width: min(100%, 340px); justify-self: center; order: -1; } }

	.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; }
	.stat { background: var(--color-surface); padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
	.stat b { font-family: var(--font-display); font-size: clamp(26px, 3.2vw, 36px); line-height: 1; font-variant-numeric: tabular-nums; }
	.stat span { font-size: 12.5px; color: var(--color-text-secondary); }

	.globe-panel { background: #11151c; color: #e8ebf0; border-radius: 16px; padding: clamp(18px, 3vw, 32px); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px; align-items: center; overflow: hidden; position: relative; }
	.globe-panel::before { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 60% at 30% 40%, rgb(163 38 42 / 0.18), transparent 70%); pointer-events: none; }
	.globe-panel h2 { color: #fff; }
	.globe-panel .eyebrow { color: #a9b0bc; }
	.globe-copy { position: relative; display: flex; flex-direction: column; gap: 12px; }
	.globe-copy p { margin: 0; color: #c3c9d3; max-width: 52ch; }
	.money-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
	.money-list a { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: center; padding: 7px 0; border-bottom: 1px solid #222a35; color: #e8ebf0; text-decoration: none; font-size: 14px; }
	.money-list a:hover { color: #fff; }
	.money-list .num { color: #a9b0bc; font-size: 13px; }
	.live-box { background: #161c25; border: 1px solid #222a35; border-radius: 12px; padding: 10px 12px; }
	.live-head { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 4px; }
	.live-head strong { color: #fff; }
	.live-status { margin-left: auto; color: #7c8492; font-size: 12px; }
	.live-dot { width: 8px; height: 8px; border-radius: 50%; background: #4cc38a; box-shadow: 0 0 0 0 rgb(76 195 138 / .6); animation: livepulse 1.8s infinite; }
	@keyframes livepulse { 0% { box-shadow: 0 0 0 0 rgb(76 195 138 / .55); } 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
	@media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }
	.live-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; min-height: 30px; }
	.live-list :global(a) { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 6px 0; border-top: 1px solid #1b222c; color: #e8ebf0; text-decoration: none; font-size: 13px; animation: ltin .5s ease; }
	.live-list :global(.lt-usd) { font-family: var(--font-mono), monospace; font-weight: 600; }
	.live-list :global(.lt-what) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.live-list :global(.lt-when) { color: #7c8492; font-size: 12px; }
	.live-empty { color: #7c8492; font-size: 12.5px; padding: 6px 0; }
	@keyframes ltin { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
	.legend-dark { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: #a9b0bc; }
	.legend-dark span { display: inline-flex; align-items: center; gap: 6px; }
	.legend-dark i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
	@media (max-width: 860px) { .globe-panel { grid-template-columns: 1fr; } }

	.trend { display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
	.trend:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgb(0 0 0 / .12); }
	.trend-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
	.trend-val { font-family: var(--font-display); font-size: 34px; line-height: 1; color: var(--bt-d); font-variant-numeric: tabular-nums; }
	.trend-chg { font-family: var(--font-mono), monospace; font-size: 12.5px; }
	.up { color: var(--bt-pos); } .down { color: var(--bt-r); }
	.trend-lab { font-weight: 600; font-size: 14px; }
	.trend-sub { font-size: 12px; color: var(--color-muted); }
	.trends { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 14px; }

	.mover { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; padding: 8px 0; border-bottom: 1px solid var(--color-border-subtle); text-decoration: none; color: inherit; }
	.mover small { grid-column: 1; color: var(--color-muted); font-size: 12px; }
	.mover .num { grid-row: span 2; align-self: center; font-size: 14px; font-weight: 600; }

	.lb { display: grid; grid-template-columns: 22px minmax(0, 1fr) 110px 56px; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--color-border-subtle); }
	.lb-rank { font-family: var(--font-mono), monospace; color: var(--color-muted); font-size: 13px; }
	.lb-name { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.lb-name small { font-weight: 400; color: var(--color-muted); }
	.lb .num { text-align: right; font-weight: 600; }
	.noms { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
	.noms ol { margin: 6px 0 0; padding-left: 18px; font-size: 14px; display: flex; flex-direction: column; gap: 3px; }

	.analysis { border-top: 3px solid var(--color-text); padding-top: 18px; }
	.analysis-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
	.analysis-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; }
	.feature { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; }
	.feature-img { border-radius: 12px; overflow: hidden; aspect-ratio: 16 / 9; background: #11151c; }
	.feature-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
	.feature-img.fallback { display: flex; align-items: center; justify-content: center; }
	.feature-img.fallback img { width: auto; height: 86%; border-radius: 8px; object-fit: contain; }
	.feature h3 { font-family: var(--font-display); font-size: clamp(24px, 3vw, 34px); line-height: 1.1; margin: 0; }
	.feature p { margin: 0; color: var(--color-text-secondary); font-size: 16px; line-height: 1.55; }
	.post-meta { font-size: 12.5px; color: var(--color-muted); }
	.headlines { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
	.headlines a { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--color-border); text-decoration: none; color: inherit; }
	.headlines a:hover strong { text-decoration: underline; }
	.headlines strong { font-size: 17px; line-height: 1.3; }
	.analysis-empty { background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: 12px; padding: 24px; color: var(--color-text-secondary); }
	@media (max-width: 860px) { .analysis-grid { grid-template-columns: 1fr; } }
	@media (max-width: 520px) { .noms { grid-template-columns: 1fr; } .lb { grid-template-columns: 18px minmax(0, 1fr) 70px 48px; } }

	.hero-h1 .w { display: inline-block; }
	:global(html.gsap-pending) .ga { visibility: hidden; }
	@media (prefers-reduced-motion: reduce) { .trend { transition: none; } }

	.ticker { display: flex; align-items: stretch; border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; background: var(--color-surface); }
	.ticker-label { flex: none; display: flex; align-items: center; padding: 0 14px; background: #a3262a; color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
	.ticker-view { overflow: hidden; flex: 1; min-width: 0; mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
	.ticker-track { list-style: none; margin: 0; padding: 0; display: flex; width: max-content; }
	.ticker-track a { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; white-space: nowrap; text-decoration: none; color: var(--color-text); font-weight: 500; font-size: 14px; border-right: 1px solid var(--color-border); }
	.ticker-track a:hover { text-decoration: underline; }
	.ticker-tag { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
	:global(html.no-ticker-motion) .ticker-view { overflow-x: auto; }

	/* midterms snapshot */
	.snap { background: #11151c; color: #e8ebf0; border-radius: 18px; padding: clamp(18px, 3vw, 30px); display: flex; flex-direction: column; gap: 18px; position: relative; overflow: hidden; }
	.snap::before { content: ""; position: absolute; inset: -40% -10% auto auto; width: 70%; height: 140%; background: radial-gradient(closest-side, rgb(163 38 42 / .22), transparent); pointer-events: none; }
	.snap h2 { color: #fff; margin: 0; }
	.snap-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; position: relative; }
	.snap-count { display: flex; flex-direction: column; align-items: flex-end; }
	.snap-count b { font-family: var(--font-display); font-size: clamp(44px, 6vw, 64px); line-height: .9; color: #fff; font-variant-numeric: tabular-nums; }
	.snap-count span { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #a9b0bc; }
	.snap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.1fr); gap: 16px; position: relative; }
	@media (max-width: 960px) { .snap-grid { grid-template-columns: 1fr 1fr; } .snap-tiles { grid-column: 1 / -1; } }
	@media (max-width: 560px) { .snap-grid { grid-template-columns: 1fr; } }
	.gauge-card { background: #161c25; border: 1px solid #222a35; border-radius: 14px; padding: 14px 16px; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 4px; transition: border-color .15s; }
	.gauge-card:hover { border-color: #3d4756; }
	.gauge-label { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: 13px; color: #a9b0bc; }
	.gauge { width: 100%; height: auto; display: block; }
	.g-track { fill: none; stroke: #222a35; stroke-width: 18; }
	.g-r { fill: none; stroke: #e85a4c; stroke-width: 18; }
	.g-d { fill: none; stroke: #5e92ee; stroke-width: 18; }
	.g-mid { stroke: #fff; stroke-width: 2; opacity: .7; }
	.gauge-nums { display: flex; justify-content: space-between; margin-top: -6px; }
	.gauge-nums b { font-family: var(--font-display); font-size: 30px; line-height: 1; font-variant-numeric: tabular-nums; }
	.gn-d { color: #5e92ee; } .gn-r { color: #e85a4c; text-align: right; }
	.gauge-sub { font-size: 12px; color: #a9b0bc; }
	.snap-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
	.snap-tile { background: #161c25; border: 1px solid #222a35; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
	.snap-tile b { font-family: var(--font-display); font-size: 28px; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
	.snap-tile span { font-size: 12.5px; color: #a9b0bc; }
	.snap-foot { margin: 0; font-size: 12.5px; color: #7c8492; position: relative; }
	.snap-foot a { color: #e8ebf0; }

	/* storylines */
	.flips { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; }
	.flip { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border-radius: 14px; background: var(--color-surface); border: 1px solid var(--color-border); text-decoration: none; color: inherit; overflow: hidden; }
	.flip::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); }
	.flip-tag { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-muted); }
	.flip-race { font-family: var(--font-display); font-size: 20px; }
	.flip-story { font-size: 14px; color: var(--color-text-secondary); }
	.flip-bars { display: flex; flex-direction: column; gap: 4px; margin-top: 4px; }
	.fb { display: block; height: 6px; background: var(--color-border); border-radius: 3px; overflow: hidden; }
	.fb i { display: block; height: 100%; background: var(--color-muted); border-radius: 3px; }
	.fb.now { height: 9px; }
	.star { display: grid; grid-template-columns: minmax(0, 1fr) 90px 56px; grid-template-rows: auto auto; gap: 2px 10px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--color-border-subtle); }
	.star-name { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.star-name small { font-weight: 400; color: var(--color-muted); }
	.star-name em { display: block; font-style: normal; font-weight: 400; font-size: 12px; color: var(--color-muted); }
	.star-bar { display: block; height: 6px; background: var(--color-border); border-radius: 3px; overflow: hidden; }
	.star-bar i { display: block; height: 100%; border-radius: 3px; }
	.star .num { text-align: right; font-weight: 600; }
	.star-ft { grid-column: 1 / -1; font-size: 12px; color: var(--color-muted); text-align: left !important; font-weight: 400 !important; }

	/* analysis lineup */
	.lineup { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
	.lineup a { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 14px 4px; border-bottom: 1px solid var(--color-border); text-decoration: none; color: inherit; transition: background .15s, padding .2s; }
	.lineup a:hover { background: var(--bt-hover); padding-left: 10px; }
	.lu-avatar { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; display: block; box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 3px var(--color-border); }
	.lu-initials { display: flex; align-items: center; justify-content: center; background: #11151c; color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 17px; }
	.lu-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.lu-title { font-family: var(--font-display); font-size: clamp(17px, 2vw, 22px); line-height: 1.2; }
	.lu-meta { font-size: 13px; color: var(--color-muted); }
	.lu-author { color: var(--color-text-secondary); font-weight: 600; }
	.lu-arrow { font-size: 20px; color: var(--color-muted); transition: transform .2s; }
	.lineup a:hover .lu-arrow { transform: translateX(4px); color: var(--color-text); }
	@media (max-width: 520px) { .lineup a { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; } .lu-avatar { width: 40px; height: 40px; } .lu-arrow { display: none; } }

	.lb-bar { display: block; height: 4px; margin-top: 5px; background: var(--color-border); border-radius: 2px; overflow: hidden; max-width: 260px; }
	.lb-bar i { display: block; height: 100%; border-radius: 2px; }
	.hl-ex { color: var(--color-text-secondary); font-size: 14px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 14px; margin-top: 22px; }
	.post-card { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); text-decoration: none; color: inherit; transition: transform .15s, box-shadow .15s; }
	.post-card:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgb(0 0 0 / .12); }
	.post-card strong { font-size: 16px; line-height: 1.3; }
</style>

<Base title={`${SITE_NAME}: political news and election odds from Kalshi and Polymarket`} description={lede.length > 158 ? lede.slice(0, 155).replace(/\s\S*$/, "") + "…" : lede} canonical={`${origin}/`}>
	<JsonLd slot="head" data={ld} />
	<div class="dp">
