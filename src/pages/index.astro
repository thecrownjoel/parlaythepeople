								</div>
								{med && <span class="gauge-sub">Median outcome: {med} Republican seats · {maj} for control</span>}
							</a>
						);
					})}
					<div class="snap-tiles">
						{sweepNow != null && <div class="snap-tile"><b data-count-pct={sweepNow}>{pct(sweepNow)}</b><span>Democrats sweep both chambers</span></div>}
						{pvNow != null && <div class="snap-tile"><b data-count-pct={pvNow}>{pct(pvNow)}</b><span>Democrats win the national House vote</span></div>}
						<div class="snap-tile"><b data-count={tossups}>{tossups}</b><span>races rated toss-up</span></div>
						<div class="snap-tile"><b data-count={traded} data-format="money">{fmtVol(traded)}</b><span>traded on {nextYear} races</span></div>
					</div>
				</div>
				<p class="snap-foot">{totalRaces.toLocaleString()} races tracked · {counts.points.toLocaleString()} price points recorded · <a href={`/${nextYear}/`}>Every {nextYear} race →</a></p>
			</section>
		)}

		{ticker.length > 0 && (
			<section class="ticker" aria-label="Latest headlines">
				<span class="ticker-label">Latest</span>
				<div class="ticker-view" data-ticker>
					<ul class="ticker-track">
						{[...ticker, ...ticker].map((t, i) => (
							<li aria-hidden={i >= ticker.length ? "true" : undefined}>
								<a href={t.href} tabindex={i >= ticker.length ? -1 : undefined} target={t.external ? "_blank" : undefined} rel={t.external ? "noopener nofollow" : undefined}><span class="ticker-tag">{t.tag}</span>{t.text}</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}

		{cards.length > 0 && (
			<section>
				<h2>The big picture</h2>
				<p class="sec-note">Democratic odds now, the change over 30 days, and the last 90 days of trading.</p>
				<div class="trends">
					{cards.map((c) => {
						const chg = sparkChange(c.spark);
						return (
							<a class="panel trend ga" data-ga="up" href={c.href}>
								<span class="trend-lab">{c.label}</span>
								<div class="trend-top">
									<span class="trend-val" data-count-pct={c.now ?? 0}>{pct(c.now)}</span>
									{chg != null && <span class={`trend-chg ${chg >= 0 ? "up" : "down"}`}>{chg >= 0 ? "▲" : "▼"} {Math.abs(chg * 100).toFixed(1)} pts / 30d</span>}
								</div>
								<Sparkline points={c.spark} color={c.color} label={`${c.label}, last 90 days`} />
