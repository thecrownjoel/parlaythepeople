---
/**
 * Home: the next election at a glance, with live trends, the money map, movers, the presidency,
 * and the Analysis desk (which carries the site between elections).
 */
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import Sparkline from "../components/Sparkline.astro";
import StateTileMap from "../components/StateTileMap.astro";
import MoneyGlobe from "../components/MoneyGlobe.astro";
import { getNews, getIndex, getCycle, consensus, shares, pct, fmtVol, fmtDate, daysUntil, PARTY_PLURAL, type Race, type PresMarket, type Source } from "../lib/markets";
import { movers, historyCounts, stateRaces } from "../lib/trends";
import { nameKey } from "../lib/names";
import { mediaUrls } from "../lib/media";
import { getSocial, pulseIndex, racePulse, compact } from "../lib/social";
import LunarCrushCredit from "../components/LunarCrushCredit.astro";
import PeriodPicker from "../components/PeriodPicker.astro";
import SnapshotBody from "../components/home/SnapshotBody.astro";
import BigPictureBody from "../components/home/BigPictureBody.astro";
import MovingBody from "../components/home/MovingBody.astro";
import PulseBody from "../components/home/PulseBody.astro";
import MapBody from "../components/home/MapBody.astro";
import MoversBody from "../components/home/MoversBody.astro";
import ClosestBody from "../components/home/ClosestBody.astro";
import GapsBody from "../components/home/GapsBody.astro";
import LeadersBody from "../components/home/LeadersBody.astro";
import MoneyBody from "../components/home/MoneyBody.astro";
import { homeData, SECTIONS, type SectionKey } from "../lib/home";
import { parsePeriod } from "../lib/period";
import { biggestTrades } from "../lib/money";
import { raceName } from "../lib/home";
import { organization, graph, authorPath, SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import "../styles/data.css";
import "../styles/home.css";

const origin = Astro.url.origin;
const index = await getIndex();
const nextYear = index?.next;
const presYear = index?.cycles.find((c) => c.offices.includes("president") && c.year >= (nextYear ?? 0))?.year;
const [next, presCycle, posts, counts, news, social] = await Promise.all([
	nextYear ? getCycle(nextYear) : Promise.resolve(null),
	presYear ? getCycle(presYear) : Promise.resolve(null),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 13 }),
	historyCounts(),
	getNews(),
	getSocial(),
]);
if (Astro.cache?.enabled) Astro.cache.set(posts.cacheHint);
const home = await homeData();
const P = Object.fromEntries(Object.entries(SECTIONS).map(([k, v]) => [k, parsePeriod(v.def, v.def)])) as Record<SectionKey, ReturnType<typeof parsePeriod>>;
const socialStart = Math.min(...Object.values(home.social?.topics ?? {}).flatMap((p) => p.series.slice(0, 1).map((x) => x[0])), Math.floor(Date.now() / 1000));
const pickerOf = (k: SectionKey) => ({ section: k, period: P[k], withNow: SECTIONS[k].asOf, presets: [...SECTIONS[k].presets] as string[], ...(k === "pulse" ? { min: new Date(socialStart * 1000).toISOString().slice(0, 10) } : {}) });

const races = next?.races ?? [];
const byId = (id: string) => races.find((r) => r.id === id);
const senC = nextYear ? byId(`${nextYear}-senate-control`) : undefined;
const houseC = nextYear ? byId(`${nextYear}-house-control`) : undefined;
const avgShares = (m?: PresMarket) => {
	const arr = (["k", "p"] as const).map((x) => m?.[x]).filter(Boolean).map((s) => shares(s as Source)!);
	return arr.length ? { D: arr.reduce((a, s) => a + s.D, 0) / arr.length, R: arr.reduce((a, s) => a + s.R, 0) / arr.length } : null;
};
const presParty = avgShares(presCycle?.pres.party);
const days = next ? daysUntil(next.meta.election_day) : null;
const when = next ? fmtDate(next.meta.generated, false) : "";

// ---- lede
const favored: { party: "D" | "R"; what: string; p: number }[] = [];
if (senC) favored.push({ party: consensus(senC).lead as "D" | "R", what: "the Senate", p: consensus(senC).lp });
if (houseC) favored.push({ party: consensus(houseC).lead as "D" | "R", what: "the House", p: consensus(houseC).lp });
if (presParty) favored.push({ party: presParty.D >= presParty.R ? "D" : "R", what: `the ${presYear} presidency`, p: Math.max(presParty.D, presParty.R) });
const list = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`);
const summary = (["D", "R"] as const)
	.map((pa) => favored.filter((f) => f.party === pa))
	.filter((fs) => fs.length)
	.map((fs) => `${PARTY_PLURAL[fs[0].party]} are favored to win ${list(fs.map((f) => `${f.what} (${pct(f.p)})`))}`);
const lede = summary.length
	? `As of ${when}, prediction markets say ${summary.join("; ")}. ${SITE_NAME} tracks every race on Kalshi and Polymarket, side by side, keeps the price history, and covers the politics behind the numbers.`
	: SITE_DESCRIPTION;

// ---- stats band
const totalRaces = (index?.cycles ?? []).reduce((a, c) => a + c.races, 0);
const traded = races.reduce((a, r) => a + (r.k?.v ?? 0) + (r.p?.v ?? 0), 0);

// ---- map & globe
const senMap = next ? stateRaces(next, "senate") : [];
const govMap = next ? stateRaces(next, "governor") : [];
const houseMap = next ? stateRaces(next, "house") : [];
const globeRaces = [
	...senMap.map((r) => ({ ...r, office: "Senate", key: r.path })),
	...govMap.map((r) => ({ ...r, office: "Governor", key: r.path })),
	...houseMap.map((r) => ({ ...r, office: "House", key: r.path })),
];
const topMoney = [...globeRaces].sort((a, b) => b.vol - a.vol).slice(0, 5);

// ---- lists
const name = (r: Race) => (r.kind === "house" ? `${r.label} (${r.state})` : `${r.state} ${r.kind === "senate" ? "Senate" : "Governor"}`);
const closest = races.filter((r) => r.kind !== "control").map((r) => ({ r, c: consensus(r) })).sort((a, b) => a.c.lp - b.c.lp).slice(0, 8);
const gaps = races.filter((r) => r.k && r.p).map((r) => ({ r, g: Math.abs(shares(r.k)!.D - shares(r.p)!.D) })).sort((a, b) => b.g - a.g).slice(0, 6);
const moved = next ? await movers(next, 7, 6) : [];

// ---- presidency leaderboard
/** Money traded on a race across both exchanges (Kalshi $1 contracts + Polymarket dollars). */
const traded$ = (r: Race) => (r.k?.v ?? 0) + (r.p?.v ?? 0);
function merged(m?: PresMarket, limit = 6) {
	if (!m) return [];
	const rows = new Map<string, { key: string; n: string; pa: string | null; vals: number[]; vol: number }>();
	for (const x of ["k", "p"] as const) {
		const s = m[x];
		if (!s) continue;
		const tot = s.o.reduce((a, o) => a + o.p, 0) || 1;
		for (const o of s.o) {
			const key = nameKey(o.n);
			const row = rows.get(key) ?? { key, n: o.n, pa: o.pa, vals: [], vol: 0 };
			row.vals.push(o.p / tot);
			row.vol += o.v ?? 0;
			row.pa = row.pa ?? o.pa;
			rows.set(key, row);
		}
	}
	return [...rows.values()].map((r) => ({ ...r, v: r.vals.reduce((a, b) => a + b, 0) / r.vals.length })).sort((a, b) => b.v - a.v).slice(0, limit);
}
const leaders = merged(presCycle?.pres.winner, 6);

// ---- ballot measures closest to a coin flip (skip thin markets)
const coinFlips = (next?.big?.ballots ?? []).filter((b: any) => !b.thin).sort((a: any, b: any) => Math.abs(a.p - 0.5) - Math.abs(b.p - 0.5)).slice(0, 6);

// ---- analysis
// Analysis lineup: one row per post with the author's photo
const avatarById = await mediaUrls(posts.entries.slice(0, 10).map((p) => p.data.bylines?.[0]?.byline?.avatarMediaId));
const lineup = posts.entries.slice(0, 10).map((p) => {
	const by = p.data.bylines?.[0]?.byline;
	return {
		href: `/posts/${p.id}`, title: p.data.title, date: p.data.publishedAt as Date | null | undefined,
		author: by?.displayName ?? SITE_NAME,
		authorHref: by?.slug ? authorPath(by.slug) : null,
		avatar: (by?.avatarMediaId && avatarById.get(by.avatarMediaId)) || null,
		initials: (by?.displayName ?? SITE_NAME).split(/\s+/).map((w: string) => w[0]).slice(0, 2).join("").toUpperCase(),
	};
});
// Ticker: newest analysis headlines first, then live market headlines.
// the day's biggest single trades, for the ticker
const bigToday = (await biggestTrades(Math.floor(Date.now() / 1000) - 86400, 3)).map((t) => {
	const r = races.find((x) => x.id === t.race_id);
	const side = t.src === "k" ? (t.side === "yes" ? "Yes on" : "No on") : t.side === "BUY" ? "bought" : "sold";
	return { text: `${fmtVol(t.usd)} trade: ${side} ${t.outcome ?? "the race"}${t.yes_price != null ? ` at ${Math.round(t.yes_price * 100)}¢` : ""}${r ? `, ${raceName(r)}` : ""}`, href: r?.path ?? "/#money-went-h", tag: "Big money" };
});
const ticker: { text: string; href: string; tag: string; external?: boolean }[] = [
	...(news?.items ?? []).slice(0, 16).map((n) => ({ text: n.title, href: n.url, tag: n.source || n.tag, external: true })),
	...posts.entries.slice(0, 2).map((p) => ({ text: p.data.title, href: `/posts/${p.id}`, tag: SITE_NAME })),
	...bigToday,
	...(senC ? [{ text: `${PARTY_PLURAL[consensus(senC).lead as "D" | "R"]} ${pct(consensus(senC).lp)} to win the Senate`, href: senC.path, tag: "Markets" }] : []),
	...(houseC ? [{ text: `${PARTY_PLURAL[consensus(houseC).lead as "D" | "R"]} ${pct(consensus(houseC).lp)} to win the House`, href: houseC.path, tag: "Markets" }] : []),
	...(presParty ? [{ text: `${presYear} presidency: Democrats ${pct(presParty.D)}, Republicans ${pct(presParty.R)}`, href: `/${presYear}/president/`, tag: "Markets" }] : []),
	...moved.slice(0, 3).map((m) => ({ text: `${name(m.race)}: Democratic odds ${m.delta >= 0 ? "up" : "down"} ${Math.abs(m.delta * 100).toFixed(1)} pts this week`, href: m.race.path, tag: "Movers" })),
	...closest.slice(0, 2).map(({ r, c }) => ({ text: `Toss-up watch: ${name(r)} at ${c.lead} ${pct(c.lp)}`, href: r.path, tag: "Close race" })),
];
// ---- the Pulse shows when LunarCrush has candidates
const pulses = Object.values(social?.topics ?? {}).filter((p) => p.kind === "candidate");

const h1Words = "Political News, Election odds from Kalshi and Polymarket, race by race".split(" ");
const postDate = (d?: Date | null) => (d ? d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "");

const ld = graph(organization(origin), {
	"@type": "WebSite", "@id": `${origin}/#site`, url: `${origin}/`, name: SITE_NAME, description: SITE_DESCRIPTION, publisher: { "@id": `${origin}/#org` },
	potentialAction: { "@type": "SearchAction", target: `${origin}/search?q={query}`, "query-input": "required name=query" },
});
---

<Base title={`${SITE_NAME}: political news and election odds from Kalshi and Polymarket`} description={lede.length > 158 ? lede.slice(0, 155).replace(/\s\S*$/, "") + "…" : lede} canonical={`${origin}/`}>
	<JsonLd slot="head" data={ld} />
	<div class="dp">
		<header class="dp-head home-hero">
			<div class="home-hero-text">
				<p class="eyebrow ga" data-ga="hero">{SITE_NAME}{days != null && days > 0 ? ` · ${days} days to the ${nextYear} election` : ""}</p>
				<h1 class="hero-h1">{h1Words.map((w) => <><span class="w ga" data-ga="word">{w}</span>{" "}</>)}</h1>
				<p class="lede ga" data-ga="hero">{lede}</p>
				{next && <p class="updated ga" data-ga="hero">Updated <time datetime={next.meta.generated}>{fmtDate(next.meta.generated)}</time></p>}
			</div>
			<img class="home-hero-logo ga" data-ga="logo" src="/brand/logo-full.png" width="760" height="936" alt={`${SITE_NAME} logo: a voter casting a ballot as dollar bills fall`} fetchpriority="high" />
		</header>


		{next && (
			<section class="snap" aria-labelledby="snap-h" data-period-section="snapshot">
				<div class="snap-head">
					<div>
						<p class="eyebrow" style="color:#a9b0bc">{nextYear} midterms · snapshot</p>
						<h2 id="snap-h">Where the {nextYear} midterms stand</h2>
					</div>
					<div class="snap-right">
						<PeriodPicker {...pickerOf("snapshot")} dark />
						<div class="snap-count"><b data-count={days ?? 0}>{days ?? "—"}</b><span>days to go</span></div>
					</div>
				</div>
				<div data-period-body><SnapshotBody d={home} period={P.snapshot} /></div>
				<p class="snap-foot">{totalRaces.toLocaleString()} races tracked · {counts.points.toLocaleString()} price points recorded · <a href={`/${nextYear}/`}>Every {nextYear} race →</a></p>
			</section>
		)}

		{ticker.length > 0 && (
			<section class="ticker" aria-label="Latest headlines">
				<span class="ticker-label">Latest</span>
				<div class="ticker-view" data-ticker>
					<ul class="ticker-track">
						{[...ticker, ...ticker].map((t, i) => (
							<li aria-hidden={i >= ticker.length ? "true" : undefined}>
								<a href={t.href} tabindex={i >= ticker.length ? -1 : undefined} target={t.external ? "_blank" : undefined} rel={t.external ? "noopener nofollow" : undefined}><span class="ticker-tag">{t.tag}</span>{t.text}</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}

		{(senC || houseC) && (
			<section data-period-section="big">
				<div class="sec-head"><h2>The big picture</h2><PeriodPicker {...pickerOf("big")} /></div>
				<div data-period-body><BigPictureBody d={home} period={P.big} /></div>
			</section>
		)}

		<section aria-labelledby="story-h" data-period-section="moving">
			<div class="sec-head"><h2 id="story-h">What's moving the markets</h2><PeriodPicker {...pickerOf("moving")} /></div>
			<div data-period-body><MovingBody d={home} period={P.moving} /></div>
		</section>

		{pulses.length > 0 && (
			<section class="pulse" aria-labelledby="pulse-h" data-period-section="pulse">
				<div class="sec-head">
					<h2 id="pulse-h">The Pulse: buzz vs. odds</h2>
					<div class="pulse-tools"><PeriodPicker {...pickerOf("pulse")} /><LunarCrushCredit /></div>
				</div>
				<div data-period-body><PulseBody d={home} period={P.pulse} /></div>
			</section>
		)}

		{globeRaces.length > 0 && (
			<section class="globe-panel ga" data-ga="globe" aria-labelledby="money-h">
				<MoneyGlobe races={globeRaces} cycle={nextYear!} totalTraded={traded} />
				<div class="globe-copy">
					<div class="gc-intro">
					<p class="eyebrow">Where the money is</p>
					<h2 id="money-h">Every {nextYear} Senate, House and governor race, live</h2>
					<p>Each line runs from Washington to a race: Senate and governor races to the state, House races to a point inside it. Drag to look around. Its color is the party the markets favor, and the brighter the pulse, the more money has traded on it. When a trade happens on Polymarket, it flashes down that race's line as it happens.</p>
					<div class="legend-dark"><span><i style="background:#5e92ee"></i>Democrat favored</span><span><i style="background:#e85a4c"></i>Republican favored</span><span><i style="background:#c9cdd5"></i>Independent</span></div>
					</div>
					<div class="gc-side">
					<div class="live-box" aria-live="polite">
						<div class="live-head"><span class="live-dot" aria-hidden="true"></span><strong>Live trades</strong><span id="live-status" class="live-status">Connecting to Polymarket…</span></div>
						<ul id="live-trades" class="live-list"><li class="live-empty">Trades on {nextYear} races appear here the moment they happen.</li></ul>
					</div>
					<p class="eyebrow" style="color:#a9b0bc;margin-top:6px">Most money traded</p>
					<ul class="money-list">
						{topMoney.map((r) => (
							<li><a href={r.path}><span>{r.state} {r.office}</span><span class="num" style={`color:${r.lead === "D" ? "#5e92ee" : r.lead === "R" ? "#e85a4c" : "#c9cdd5"}`}>{r.lead} {pct(r.lp)}</span><span class="num">{fmtVol(r.vol)}</span></a></li>
						))}
					</ul>
					</div>
				</div>
			</section>
		)}

		<section aria-labelledby="money-went-h" data-period-section="money">
			<div class="sec-head"><h2 id="money-went-h">Where the money went</h2><PeriodPicker {...pickerOf("money")} /></div>
			<div data-period-body><MoneyBody d={home} period={P.money} /></div>
		</section>

		{senMap.length > 0 && (
			<section data-ga-map data-period-section="map">
				<div class="sec-head"><h2>The {nextYear} map</h2><PeriodPicker {...pickerOf("map")} /></div>
				<div data-period-body><MapBody d={home} period={P.map} /></div>
			</section>
		)}

		<div class="grid3">
			<section class="panel" data-period-section="movers">
				<div class="sec-head"><h2 style="font-size:22px">Biggest moves</h2><PeriodPicker {...pickerOf("movers")} /></div>
				<div data-period-body><MoversBody d={home} period={P.movers} /></div>
			</section>
			{closest.length > 0 && (
				<section class="panel" data-period-section="closest">
					<div class="sec-head"><h2 style="font-size:22px">Closest {nextYear} races</h2><PeriodPicker {...pickerOf("closest")} /></div>
					<div data-period-body><ClosestBody d={home} period={P.closest} /></div>
				</section>
			)}
			{gaps.length > 0 && (
				<section class="panel" data-period-section="gaps">
					<div class="sec-head"><h2 style="font-size:22px">Where the exchanges disagree</h2><PeriodPicker {...pickerOf("gaps")} /></div>
					<div data-period-body><GapsBody d={home} period={P.gaps} /></div>
				</section>
			)}
		</div>

		{leaders.length > 0 && (
			<section class="panel" data-period-section="leaders">
				<div class="sec-head">
					<h2>Who wins the White House in {presYear}?</h2>
					<div class="pulse-tools"><PeriodPicker {...pickerOf("leaders")} /><a href={`/${presYear}/president/`} class="datalinks">Full presidential odds →</a></div>
				</div>
				<div data-period-body><LeadersBody d={home} period={P.leaders} /></div>
			</section>
		)}

		<section class="analysis" aria-labelledby="analysis-h">
			<div class="analysis-head">
				<h2 id="analysis-h" style="margin:0;font-size:clamp(28px,4vw,40px)">Analysis</h2>
				<a href="/posts" class="datalinks">Every article →</a>
			</div>
			{lineup.length > 0 ? (
				<ol class="lineup">
					{lineup.map((p) => (
						<li class="ga" data-ga="line">
							<div class="lu-row">
								{p.avatar ? <img class="lu-avatar" src={p.avatar} alt="" width="52" height="52" loading="lazy" /> : <span class="lu-avatar lu-initials" aria-hidden="true">{p.initials}</span>}
								<span class="lu-text">
									<a class="lu-title" href={p.href}>{p.title}</a>
									<span class="lu-meta">{p.authorHref ? <a class="lu-author" href={p.authorHref} rel="author">{p.author}</a> : <span class="lu-author">{p.author}</span>}{p.date && <> · <time datetime={p.date.toISOString()}>{postDate(p.date)}</time></>}</span>
								</span>
								<span class="lu-arrow" aria-hidden="true">→</span>
							</div>
						</li>
					))}
				</ol>
			) : (
				<div class="analysis-empty">The {SITE_NAME} desk publishes analysis of the races and the politics behind them here. The first articles are on the way.</div>
			)}
		</section>

		{coinFlips.length > 0 && (
			<section>
				<h2>Ballot measures on a knife's edge</h2>
				<p class="sec-note">State measures the markets see as closest to a coin flip.</p>
				<ul class="racelist">
					{coinFlips.map((b: any) => <li><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{b.st}: {b.n}</span><span class="num">{pct(b.p)} pass <span class="money">{fmtVol(b.v)}</span></span></li>)}
				</ul>
			</section>
		)}

		<section>
			<h2>Explore</h2>
			<p class="datalinks">
				{(index?.cycles ?? []).map((c) => <a href={c.offices.includes("president") && c.races < 5 ? `/${c.year}/president/` : `/${c.year}/`}>{c.year} elections</a>)}
				<a href="/methodology/">Methodology</a><a href="/data/">Data &amp; API</a>
			</p>
		</section>
	</div>
</Base>

<script is:inline>
	// Hide animatable pieces until GSAP has set their starting positions (never longer than 2.5s).
	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		document.documentElement.classList.add("gsap-pending");
		setTimeout(() => document.documentElement.classList.remove("gsap-pending"), 2500);
	}
</script>
<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	gsap.registerPlugin(ScrollTrigger);
	const root = document.documentElement;
	const money = (v: number) => (v >= 1e6 ? `$${(v / 1e6).toFixed(1)}M` : v >= 1e3 ? `$${Math.round(v / 1e3)}K` : `$${Math.round(v)}`);

	// Ticker: seamless loop of the duplicated list; pauses on hover/focus.
	const startTicker = (animate: boolean) => {
		const view = document.querySelector<HTMLElement>("[data-ticker]");
		const track = view?.querySelector<HTMLElement>(".ticker-track");
		if (!view || !track) return;
		if (!animate) { root.classList.add("no-ticker-motion"); return; }
		const half = track.scrollWidth / 2;
		const tween = gsap.to(track, { x: -half, duration: half / 45, ease: "none", repeat: -1 });
		view.addEventListener("mouseenter", () => tween.pause());
		view.addEventListener("mouseleave", () => tween.play());
		view.addEventListener("focusin", () => tween.pause());
		view.addEventListener("focusout", () => tween.play());
	};

	const mm = gsap.matchMedia();
	mm.add("(prefers-reduced-motion: no-preference)", () => {
		// Hero
		const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
		tl.from(".hero-h1 .w", { yPercent: 110, opacity: 0, rotate: 4, duration: 0.7, stagger: 0.045 })
			.from("[data-ga='hero']", { y: 18, opacity: 0, duration: 0.6, stagger: 0.12 }, 0.25)
			.from("[data-ga='logo']", { scale: 0.82, rotate: -6, opacity: 0, duration: 1.1, ease: "elastic.out(1, 0.6)" }, 0.15);

		// Count-ups
		document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
			const end = Number(el.dataset.count), isMoney = el.dataset.format === "money", o = { v: 0 };
			gsap.to(o, { v: end, duration: 1.6, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 92%" },
				onUpdate: () => (el.textContent = isMoney ? money(o.v) : Math.round(o.v).toLocaleString()) });
		});
		document.querySelectorAll<HTMLElement>("[data-count-pct]").forEach((el) => {
			const end = Number(el.dataset.countPct) * 100, o = { v: 0 };
			gsap.to(o, { v: end, duration: 1.4, ease: "power2.out", scrollTrigger: { trigger: el, start: "top 92%" },
				onUpdate: () => (el.textContent = `${Math.round(o.v)}%`) });
		});

		// Snapshot gauges sweep in
		document.querySelectorAll<SVGPathElement>("[data-gauge]").forEach((g) => {
			const len = 251.3 * Number(g.dataset.gauge);
			gsap.fromTo(g, { attr: { "stroke-dasharray": `0 251.3` } }, { attr: { "stroke-dasharray": `${len} 251.3` }, duration: 1.8, ease: "power3.inOut", delay: 0.3,
				scrollTrigger: { trigger: g, start: "top 95%" } });
		});
		gsap.from(".snap .gauge-card, .snap .snap-tile", { y: 24, opacity: 0, duration: 0.7, stagger: 0.08, ease: "power3.out", delay: 0.2, clearProps: "transform,opacity" });

		// Lead-change cards flip in
		gsap.set("[data-ga='flip']", { rotateX: -70, opacity: 0, transformPerspective: 800, transformOrigin: "50% 0%" });
		ScrollTrigger.batch("[data-ga='flip']", { start: "top 92%", once: true,
			onEnter: (els) => gsap.to(els, { rotateX: 0, opacity: 1, duration: 0.9, ease: "back.out(1.4)", stagger: 0.1, clearProps: "transform,opacity" }) });

		// Analysis lineup slides in line by line
		gsap.set("[data-ga='line']", { x: -40, opacity: 0 });
		ScrollTrigger.batch("[data-ga='line']", { start: "top 92%", once: true,
			onEnter: (els) => gsap.to(els, { x: 0, opacity: 1, duration: 0.6, ease: "power3.out", stagger: 0.08, clearProps: "transform,opacity" }) });
		gsap.utils.toArray<HTMLElement>(".lu-avatar").forEach((a) => gsap.from(a, { scale: 0, duration: 0.6, ease: "back.out(2.2)", scrollTrigger: { trigger: a, start: "top 92%" } }));

		// Rise-in for cards, rows, articles
		gsap.set("[data-ga='up']", { y: 26, opacity: 0, transition: "none" });
		ScrollTrigger.batch("[data-ga='up']", { start: "top 90%", once: true,
			onEnter: (els) => gsap.to(els, { y: 0, opacity: 1, duration: 0.7, ease: "power3.out", stagger: 0.07, clearProps: "transform,translate,opacity,transition" }) });

		// Sparklines draw themselves
		document.querySelectorAll<SVGPathElement>(".spark-line").forEach((path) => {
			gsap.fromTo(path, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1.6, ease: "power2.inOut",
				scrollTrigger: { trigger: path, start: "top 92%" } });
		});

		// Leaderboard bars grow
		gsap.utils.toArray<HTMLElement>("[data-ga-bar]").forEach((bar) => {
			gsap.from(bar, { scaleX: 0, transformOrigin: "left center", duration: 1.1, ease: "power3.out", scrollTrigger: { trigger: bar, start: "top 92%" } });
		});

		// Map tiles fill in from the center
		document.querySelectorAll<HTMLElement>("[data-ga-map]").forEach((sec) => {
			const tiles = sec.querySelectorAll(".stm-grid:not([hidden]) .stm-tile");
			// explicit end values + transition off while animating (the tiles' CSS hover transition would fight GSAP)
			gsap.fromTo(tiles, { scale: 0.4, opacity: 0, transition: "none" }, { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(2)",
				stagger: { grid: [8, 12], from: "center", amount: 0.9 }, scrollTrigger: { trigger: sec, start: "top 80%" },
				clearProps: "transform,scale,opacity,transition" });
		});

		// Globe panel: rises in, then drifts gently with the scroll
		const globe = document.querySelector<HTMLElement>("[data-ga='globe']");
		if (globe) {
			gsap.from(globe, { y: 60, opacity: 0, scale: 0.97, duration: 1, ease: "power3.out", scrollTrigger: { trigger: globe, start: "top 85%" } });
			gsap.to(globe.querySelector("[data-globe]"), { y: -30, ease: "none", scrollTrigger: { trigger: globe, start: "top bottom", end: "bottom top", scrub: true } });
		}

		root.classList.remove("gsap-pending");
		startTicker(true);
		return () => root.classList.remove("gsap-pending");
	});
	mm.add("(prefers-reduced-motion: reduce)", () => { root.classList.remove("gsap-pending"); startTicker(false); });
</script>
