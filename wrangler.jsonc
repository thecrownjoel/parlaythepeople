{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "parlaythepeople",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "ece401f47370ecab76cbc85bf2a7054c",
	"d1_databases": [
		{
			// EmDash CMS content (posts, pages, users, settings)
			"binding": "DB",
			"database_name": "ballottape-cms",
			"database_id": "eb8d63c8-68c7-486f-9961-e3177f7a5fa3",
		},
		{
			// Market data: races index and price history, written by the collector
			"binding": "MARKETS",
			"database_name": "ballottape-markets",
			"database_id": "788f4e77-c852-4a19-8e16-c1a9df33999d",
		},
		{
			// Every individual trade on both exchanges, archived by the collector
			"binding": "TRADES",
			"database_name": "ballottape-trades",
			"database_id": "0b9797e9-685b-4549-ac2b-fa65f6be8957",
		},
		{
			// Reader accounts, sessions, passkeys, plans and metered AI usage (ingest/accounts_schema.sql)
			"binding": "ACCOUNTS",
			"database_name": "parlay-accounts",
			"database_id": "22b8e7cc-538b-4d44-9b95-11920f469458",
		},
	],
	// Cloudflare Email Service: sign-in links, daily briefings and alerts (from @parlaythepeople.com)
	"send_email": [{ "name": "EMAIL" }],
	// Race analogs (Pro): 32-day odds paths of every race (src/lib/analogs.ts)
	"vectorize": [{ "binding": "ANALOGS", "index_name": "race-analogs" }],
	// Morning briefings: one durable workflow run per Pro reader per day (src/lib/briefing.ts)
	"workflows": [
		{ "name": "parlay-briefing", "binding": "BRIEFING", "class_name": "BriefingWorkflow" },
		// The Parlay Newsroom: one durable run per story (research, write, fact-check, draft) (src/lib/newsroom/workflow.ts)
		{ "name": "parlay-newsroom", "binding": "NEWSROOM", "class_name": "NewsroomWorkflow" },
	],
	"vars": {
		// AI Gateway for every Workers AI call ("default" is created by Cloudflare on first use)
		"AI_GATEWAY_ID": "default",
		// "1" takes the public site down behind a "back soon" page (src/middleware.ts); the admin stays up
		"MAINTENANCE": "0",
	},
	"ai": { "binding": "AI" },
	// Browser Rendering: draws the per-race share images (/og/race/<id>.png)
	"browser": { "binding": "BROWSER" },
	"r2_buckets": [
		{ "binding": "MEDIA", "bucket_name": "ballottape-media" },
		// Full per-cycle data files (cycles/<year>.json, index.json), written by the collector
		{ "binding": "DATA", "bucket_name": "ballottape-data" },
		// Research documents (race dossiers, headline digests, analysis) indexed by AI Search "parlay"
		{ "binding": "KNOWLEDGE", "bucket_name": "parlay-knowledge" },
	],
	"observability": { "enabled": true },
	// Custom domains (Cloudflare creates the DNS records and certificates)
	"routes": [
		{ "pattern": "parlaythepeople.com", "custom_domain": true },
		{ "pattern": "www.parlaythepeople.com", "custom_domain": true },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger (EmDash scheduled publishing etc.)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
